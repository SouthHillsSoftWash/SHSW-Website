---
import ServiceLayout from "../../layouts/ServiceLayout.astro";
import ServiceFAQ from "../../components/ServiceFAQ.astro";

const faqs = [
    {
        question: "What areas around a dumpster pad can be cleaned?",
        answer: "Depending on the property, cleaning may include qualifying pad surfaces and surrounding compatible hard surfaces included in the agreed-upon scope.",
    },
    {
        question: "Can cleaning remove grease and food-related stains?",
        answer: "Some grease, food, beverage, and waste-related buildup may respond to appropriate cleaning. Results depend on the contaminant, surface material, age of the stain, and condition of the surface.",
    },
    {
        question: "Will every stain come out?",
        answer: "No. Porous surfaces can absorb contaminants, and some discoloration may become permanent. Cleaning may improve applicable buildup without guaranteeing complete stain removal.",
    },
    {
        question: "Can you clean the surrounding pavement too?",
        answer: "Additional qualifying surfaces around the dumpster area can be discussed when requesting a quote and evaluated as part of the project scope.",
    },
    {
        question: "Does cleaning repair damaged concrete?",
        answer: "No. Cleaning does not repair cracks, spalling, deterioration, or other physical damage to concrete or surrounding surfaces.",
    },
    {
        question: "How often should dumpster pads be cleaned?",
        answer: "Cleaning frequency depends on how heavily the area is used, the type of waste handled, surrounding conditions, weather exposure, and property maintenance needs.",
    },
    {
        question:
            "Can dumpster pad cleaning be combined with other exterior cleaning?",
        answer: "If multiple exterior areas need attention, identify them when requesting a quote so the requested services can be evaluated together.",
    },
    {
        question: "How do I request a dumpster pad cleaning quote?",
        answer: "Contact South Hills Soft Wash with information about the property, approximate area needing attention, surface type if known, and any particular buildup or staining concerns.",
    },
];
---

<ServiceLayout
    title="Dumpster Pad Cleaning"
    seoTitle="Dumpster Pad Cleaning"
    description="Exterior cleaning for qualifying dumpster pads and surrounding surfaces affected by frequent use, spills, grime, and outdoor exposure."
    image="/images/commercial/dumpster_cleaning.jpg"
    seoDescription="Commercial dumpster pad cleaning from South Hills Soft Wash for businesses and properties throughout the South Hills and surrounding Pittsburgh communities."
    category="Commercial"
>
    <p class="section-eyebrow">Commercial Dumpster Areas</p>

    <h2>Give a Hard-Working Area Some Attention</h2>

    <p>
        Dumpster areas are exposed to frequent use, spills, environmental
        debris, and changing weather. Over time, surrounding surfaces can
        accumulate visible grime and staining.
    </p>

    <p>
        Dumpster pad cleaning can address suitable buildup on qualifying
        surfaces while accounting for the material, condition, and specific
        concerns present at the property.
    </p>

    <div slot="extra">
        <!-- ============================================
         DUMPSTER AREAS
        ============================================= -->
        <section class="service-info-section">
            <div class="service-info-heading">
                <p class="section-eyebrow">Around the Dumpster Area</p>
                <h2>Cleaning More Than the Main Pad</h2>
                <p>
                    The requested scope can include qualifying surfaces within
                    and immediately surrounding the dumpster area.
                </p>
            </div>

            <div class="service-info-grid">
                <div class="service-info-card">
                    <span>01</span>
                    <h3>Pad Surfaces</h3>
                    <p>
                        Addressing suitable grime and staining across compatible
                        dumpster pad surfaces.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>02</span>
                    <h3>Surrounding Pavement</h3>
                    <p>
                        Cleaning applicable nearby hard surfaces affected by
                        traffic, spills, and environmental buildup.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>03</span>
                    <h3>Approach Areas</h3>
                    <p>
                        Addressing qualifying surfaces used when accessing the
                        dumpster area where included in the project.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>04</span>
                    <h3>Adjacent Hard Surfaces</h3>
                    <p>
                        Including other compatible exterior surfaces when
                        appropriate to the agreed-upon scope.
                    </p>
                </div>
            </div>
        </section>

        <!-- ============================================
         COMMON DUMPSTER PAD CONCERNS
        ============================================= -->
        <section class="service-info-section service-info-split">
            <div>
                <p class="section-eyebrow">Common Dumpster Pad Concerns</p>
                <h2>Frequent Use Creates Tough Buildup</h2>
            </div>

            <div class="service-info-copy">
                <p>
                    Waste handling areas can experience several forms of buildup
                    from everyday commercial use and outdoor exposure.
                </p>

                <ul class="service-check-list">
                    <li>Dirt and environmental grime</li>
                    <li>Food and beverage residue</li>
                    <li>Suitable grease-related buildup</li>
                    <li>Waste-related surface staining</li>
                    <li>Organic buildup</li>
                    <li>Traffic-related grime</li>
                </ul>

                <p>
                    Some contaminants can penetrate porous surfaces and leave
                    permanent discoloration. Cleaning may improve applicable
                    buildup without restoring damaged material.
                </p>
            </div>
        </section>

        <!-- ============================================
         CLEANING APPROACH
        ============================================= -->
        <section class="service-info-section service-method-section">
            <div class="service-info-heading">
                <p class="section-eyebrow">The Cleaning Approach</p>
                <h2>The Type of Buildup Matters</h2>
            </div>

            <div class="service-method-content">
                <p>
                    Dumpster areas can contain several types of contaminants as
                    well as different concrete, pavement, and surrounding
                    exterior surfaces.
                </p>

                <p>
                    The cleaning approach should account for the material,
                    condition, type of buildup, and characteristics of the
                    property.
                </p>

                <p>
                    Evaluating the requested area helps establish an appropriate
                    scope and cleaning plan.
                </p>
            </div>
        </section>

        <!-- ============================================
         PROPERTY MAINTENANCE
        ============================================= -->
        <section class="service-info-section service-info-split">
            <div>
                <p class="section-eyebrow">Property Maintenance</p>
                <h2>Maintain an Often-Overlooked Area</h2>
            </div>

            <div class="service-info-copy">
                <p>
                    Dumpster areas may not be customer-facing, but they are
                    still part of the exterior property and can accumulate
                    noticeable buildup through frequent use.
                </p>

                <ul class="service-check-list">
                    <li>Addresses suitable spills and surface grime</li>
                    <li>Refreshes qualifying hard surfaces</li>
                    <li>Improves the appearance of waste-handling areas</li>
                    <li>Complements other commercial exterior cleaning</li>
                    <li>Supports ongoing exterior property maintenance</li>
                </ul>

                <p>
                    Cleaning does not replace waste management, pest control,
                    concrete repair, drainage repair, or other property
                    maintenance services.
                </p>
            </div>
        </section>

        <!-- ============================================
         PROCESS
        ============================================= -->
        <section class="service-info-section">
            <div class="service-info-heading">
                <p class="section-eyebrow">What to Expect</p>
                <h2>Our Dumpster Pad Cleaning Process</h2>
                <p>
                    The surface, condition, accessibility, and type of buildup
                    help determine an appropriate cleaning plan.
                </p>
            </div>

            <div class="service-process-grid">
                <div class="service-process-step">
                    <span>01</span>
                    <h3>Discuss the Area</h3>
                    <p>
                        Identify the surfaces and particular buildup or staining
                        you would like addressed.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>02</span>
                    <h3>Evaluate the Surface</h3>
                    <p>
                        Consider material, condition, accessibility, and the
                        type of buildup present.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>03</span>
                    <h3>Perform the Cleaning</h3>
                    <p>
                        Address the agreed-upon qualifying areas using
                        appropriate cleaning methods.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>04</span>
                    <h3>Review the Results</h3>
                    <p>
                        Review cleaned surfaces and discuss remaining permanent
                        staining or surface concerns.
                    </p>
                </div>
            </div>
        </section>

        <!-- ============================================
         FAQ
        ============================================= -->
        <ServiceFAQ faqs={faqs} />
    </div>
</ServiceLayout>
