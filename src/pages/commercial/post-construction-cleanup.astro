---
import ServiceLayout from "../../layouts/ServiceLayout.astro";
import ServiceFAQ from "../../components/ServiceFAQ.astro";

const faqs = [
    {
        question: "What does exterior post-construction cleanup include?",
        answer: "The scope depends on the property and project. Qualifying exterior surfaces affected by suitable construction-related dirt, dust, and debris can be evaluated to determine what cleaning is appropriate.",
    },
    {
        question: "Can you remove construction dust and dirt?",
        answer: "Many forms of suitable exterior dust and surface dirt may be addressed through cleaning. Results depend on the material, condition, and nature of the residue.",
    },
    {
        question:
            "Can you remove paint, adhesive, mortar, or other construction materials?",
        answer: "Specialty residues such as paint, adhesives, mortar, sealants, or similar materials may require methods beyond routine exterior cleaning and can potentially damage underlying surfaces. These concerns should be identified and evaluated separately.",
    },
    {
        question: "Can newly installed exterior materials be cleaned?",
        answer: "New materials may have manufacturer-specific care requirements, curing periods, coatings, or warranty considerations. These factors should be reviewed before cleaning.",
    },
    {
        question: "Does post-construction cleanup include interior cleaning?",
        answer: "This page describes exterior post-construction cleaning. Any services outside that scope should be discussed separately with South Hills Soft Wash.",
    },
    {
        question: "Can exterior walkways and pavement be included?",
        answer: "Qualifying exterior hard surfaces may be considered as part of the project depending on their material, condition, and the type of construction-related buildup present.",
    },
    {
        question: "Will cleaning correct construction defects or damage?",
        answer: "No. Cleaning does not repair defective installation, damaged materials, scratches, overspray damage, failed coatings, or other construction-related defects.",
    },
    {
        question: "How do I request a post-construction cleanup quote?",
        answer: "Contact South Hills Soft Wash with information about the project, requested exterior areas, materials involved, and the type of residue or buildup present. Photos can be especially helpful when evaluating construction-related cleaning.",
    },
];
---

<ServiceLayout
    title="Post-Construction Cleanup"
    seoTitle="Post-Construction Exterior Cleanup"
    description="Exterior cleanup for qualifying post-construction projects to address suitable dirt, dust, debris, and surface buildup before the property moves into its next stage of use."
    image="/images/commercial/post_construction.jpg"
    seoDescription="Post-construction exterior cleanup from South Hills Soft Wash for commercial properties throughout the South Hills and surrounding Pittsburgh communities."
    category="Commercial"
>
    <p class="section-eyebrow">Exterior Post-Construction Cleanup</p>

    <h2>Finish the Project With a Cleaner Exterior</h2>

    <p>
        Construction and renovation work can leave exterior areas covered in
        dust, dirt, footprints, environmental debris, and other surface buildup
        even after the primary work is complete.
    </p>

    <p>
        Exterior post-construction cleanup can address qualifying surfaces and
        suitable residue while accounting for newly installed materials,
        existing finishes, and the condition of the property.
    </p>

    <div slot="extra">
        <!-- ============================================
         PROJECT AREAS
        ============================================= -->
        <section class="service-info-section">
            <div class="service-info-heading">
                <p class="section-eyebrow">Project Areas</p>
                <h2>Exterior Cleaning After Construction</h2>
                <p>
                    Construction projects can affect several exterior areas, and
                    each material may have different cleaning requirements.
                </p>
            </div>

            <div class="service-info-grid">
                <div class="service-info-card">
                    <span>01</span>
                    <h3>Building Exteriors</h3>
                    <p>
                        Addressing suitable construction-related dirt and
                        buildup on compatible exterior building materials.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>02</span>
                    <h3>Walkways</h3>
                    <p>
                        Cleaning qualifying exterior walking surfaces affected
                        by suitable construction dust, dirt, and traffic.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>03</span>
                    <h3>Paved Areas</h3>
                    <p>
                        Addressing compatible exterior hard surfaces included in
                        the agreed-upon project scope.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>04</span>
                    <h3>Exterior Common Areas</h3>
                    <p>
                        Cleaning other qualifying outdoor surfaces affected
                        during construction or renovation work.
                    </p>
                </div>
            </div>
        </section>

        <!-- ============================================
         CONSTRUCTION BUILDUP
        ============================================= -->
        <section class="service-info-section service-info-split">
            <div>
                <p class="section-eyebrow">Construction Buildup</p>
                <h2>What's Left After the Work Is Done?</h2>
            </div>

            <div class="service-info-copy">
                <p>
                    Construction activity can create several forms of exterior
                    surface buildup, but not every construction residue is
                    appropriate for routine cleaning.
                </p>

                <ul class="service-check-list">
                    <li>Construction dust</li>
                    <li>Dirt and environmental grime</li>
                    <li>Foot and equipment traffic residue</li>
                    <li>Suitable loose surface debris</li>
                    <li>Weather-related buildup during construction</li>
                    <li>General exterior surface dirt</li>
                </ul>

                <p>
                    Paint, mortar, adhesives, sealants, coatings, and other
                    specialty construction residues may require separate
                    evaluation and may fall outside routine exterior cleaning.
                </p>
            </div>
        </section>

        <!-- ============================================
         CLEANING APPROACH
        ============================================= -->
        <section class="service-info-section service-method-section">
            <div class="service-info-heading">
                <p class="section-eyebrow">The Cleaning Approach</p>
                <h2>New Materials Require Care</h2>
            </div>

            <div class="service-method-content">
                <p>
                    Newly installed materials may have specific cleaning
                    instructions, curing requirements, coatings, finishes, or
                    manufacturer recommendations.
                </p>

                <p>
                    The surface material, age, condition, and type of residue
                    should therefore be considered before determining whether
                    and how an area should be cleaned.
                </p>

                <p>
                    Cleaning should not be used as a substitute for correcting
                    construction defects, damaged finishes, improper
                    installation, or other underlying problems.
                </p>
            </div>
        </section>

        <!-- ============================================
         FINISHING THE EXTERIOR
        ============================================= -->
        <section class="service-info-section service-info-split">
            <div>
                <p class="section-eyebrow">Finishing the Exterior</p>
                <h2>Help the Completed Work Look Complete</h2>
            </div>

            <div class="service-info-copy">
                <p>
                    Once construction is finished, suitable exterior cleaning
                    can help remove applicable surface buildup left by the
                    project and surrounding outdoor conditions.
                </p>

                <ul class="service-check-list">
                    <li>Addresses suitable construction dust and dirt</li>
                    <li>Refreshes qualifying exterior surfaces</li>
                    <li>Removes applicable everyday project buildup</li>
                    <li>
                        Helps prepare exterior areas for their next stage of use
                    </li>
                    <li>
                        Provides an opportunity to identify remaining surface
                        concerns
                    </li>
                </ul>

                <p>
                    Exterior cleaning does not replace contractor punch-list
                    work, repairs, painting, restoration, or correction of
                    damaged materials.
                </p>
            </div>
        </section>

        <!-- ============================================
         PROCESS
        ============================================= -->
        <section class="service-info-section">
            <div class="service-info-heading">
                <p class="section-eyebrow">What to Expect</p>
                <h2>Our Post-Construction Cleanup Process</h2>
                <p>
                    The project, materials, condition, and type of residue help
                    determine which exterior cleaning is appropriate.
                </p>
            </div>

            <div class="service-process-grid">
                <div class="service-process-step">
                    <span>01</span>
                    <h3>Discuss the Project</h3>
                    <p>
                        Identify the construction work, requested exterior
                        areas, and residue or buildup needing attention.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>02</span>
                    <h3>Evaluate the Surfaces</h3>
                    <p>
                        Consider materials, finishes, condition, age, and
                        relevant manufacturer requirements.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>03</span>
                    <h3>Perform the Cleanup</h3>
                    <p>
                        Address agreed-upon qualifying surfaces using methods
                        appropriate for the material and buildup.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>04</span>
                    <h3>Review the Results</h3>
                    <p>
                        Review cleaned areas and identify remaining specialty
                        residue, damage, or other surface concerns.
                    </p>
                </div>
            </div>
        </section>

        <!-- ============================================
         FAQ
        ============================================= -->
        <ServiceFAQ faqs={faqs} />
    </div>
</ServiceLayout>
