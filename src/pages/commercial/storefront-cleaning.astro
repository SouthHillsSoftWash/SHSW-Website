---
import ServiceLayout from "../../layouts/ServiceLayout.astro";
import ServiceFAQ from "../../components/ServiceFAQ.astro";

const faqs = [
    {
        question: "What parts of my storefront can be cleaned?",
        answer: "Depending on the property, storefront cleaning may include qualifying exterior walls, entrances, walkways, and other customer-facing exterior surfaces. The requested areas can be evaluated when determining the scope of work."
    },
    {
        question: "Can you clean just the entrance to my business?",
        answer: "If only a particular exterior area needs attention, include that when requesting your quote. The requested area can be evaluated individually when determining an appropriate scope for the project."
    },
    {
        question: "Do you use the same cleaning method on every storefront surface?",
        answer: "No. Storefronts can contain several different exterior materials. The appropriate cleaning method depends on the surface, its condition, and the type of buildup being addressed."
    },
    {
        question: "Can storefront cleaning remove algae and organic buildup?",
        answer: "Exterior cleaning can address many types of suitable organic buildup and related discoloration. Results depend on the affected material, the extent of the buildup, and the underlying condition of the surface."
    },
    {
        question: "Will storefront cleaning remove every stain?",
        answer: "Not every type of discoloration is removable through routine exterior cleaning. Permanent staining, oxidation, weathering, deteriorated finishes, and changes within the material may remain."
    },
    {
        question: "How often should a storefront be cleaned?",
        answer: "Cleaning frequency varies by property. Foot traffic, nearby roads, weather exposure, surrounding vegetation, moisture, and the appearance standards of the business can all influence how quickly exterior buildup becomes noticeable."
    },
    {
        question: "Is storefront cleaning only for retail businesses?",
        answer: "Storefront-style exterior cleaning may be appropriate for a variety of customer-facing commercial properties, not only traditional retail stores. The property and requested surfaces can be evaluated to determine an appropriate scope of work."
    },
    {
        question: "Can walkways and exterior common areas be included?",
        answer: "If there are additional exterior areas you would like addressed, mention them when requesting your quote. Different surfaces may require different cleaning methods and can be evaluated as part of the requested project."
    },
    {
        question: "How do I request a storefront cleaning quote?",
        answer: "Contact South Hills Soft Wash with information about your business, the exterior areas you would like cleaned, and any particular concerns. Photos can also help communicate the condition and scope of the requested work."
    }
];
---

<ServiceLayout
    title="Storefront Cleaning"
    description="Exterior storefront cleaning to address dirt, organic buildup, and everyday grime across customer-facing areas of your commercial property."
    image="/images/commercial/storefront.jpg"
    category="Commercial"
>

    <p class="section-eyebrow">Commercial Storefront Cleaning</p>

    <h2>Make a Better First Impression</h2>

    <p>
        Your storefront is often the first part of your business a customer
        sees. Regular exposure to weather, foot traffic, nearby vehicles,
        moisture, and environmental debris can gradually affect the
        appearance of customer-facing exterior surfaces.
    </p>

    <p>
        Storefront cleaning helps address suitable exterior buildup while
        accounting for the different materials and conditions found around
        entrances, walls, walkways, and other visible areas.
    </p>


    <div slot="extra">

        <!-- STOREFRONT AREAS -->

        <section class="service-info-section">

            <div class="service-info-heading">

                <p class="section-eyebrow">Customer-Facing Areas</p>

                <h2>Refresh the Exterior of Your Business</h2>

                <p>
                    A storefront includes more than one exterior surface.
                    Different areas experience different types of exposure
                    and should be evaluated according to their material,
                    condition, and cleaning needs.
                </p>

            </div>


            <div class="service-info-grid">

                <div class="service-info-card">

                    <span>01</span>

                    <h3>Exterior Walls</h3>

                    <p>
                        Addressing suitable dirt, grime, and organic buildup
                        across compatible customer-facing building surfaces.
                    </p>

                </div>


                <div class="service-info-card">

                    <span>02</span>

                    <h3>Entrances</h3>

                    <p>
                        Refreshing applicable exterior surfaces around one
                        of the most frequently seen and used areas of the
                        business.
                    </p>

                </div>


                <div class="service-info-card">

                    <span>03</span>

                    <h3>Walkways</h3>

                    <p>
                        Addressing compatible walking surfaces affected by
                        regular foot traffic, weather, and environmental
                        buildup.
                    </p>

                </div>


                <div class="service-info-card">

                    <span>04</span>

                    <h3>High-Visibility Areas</h3>

                    <p>
                        Focusing attention on qualifying exterior surfaces
                        that contribute heavily to the overall appearance
                        of the storefront.
                    </p>

                </div>

            </div>

        </section>


        <!-- COMMON STOREFRONT BUILDUP -->

        <section class="service-info-section service-info-split">

            <div>

                <p class="section-eyebrow">Common Storefront Concerns</p>

                <h2>Everyday Exposure Adds Up</h2>

            </div>


            <div class="service-info-copy">

                <p>
                    Storefronts are constantly exposed to customers,
                    employees, changing weather, nearby traffic, and
                    environmental debris. These conditions can gradually
                    affect the appearance of exterior surfaces.
                </p>

                <ul class="service-check-list">

                    <li>Dirt and environmental grime</li>
                    <li>Green algae and organic buildup</li>
                    <li>Pollen and seasonal debris</li>
                    <li>Traffic-related exterior grime</li>
                    <li>Dark discoloration in damp or shaded areas</li>
                    <li>Weather-related surface buildup</li>

                </ul>

                <p>
                    Some discoloration may be related to aging, oxidation,
                    deteriorated finishes, permanent staining, or other
                    changes within the material. Cleaning may improve
                    appearance without reversing those conditions.
                </p>

            </div>

        </section>


        <!-- CLEANING APPROACH -->

        <section class="service-info-section service-method-section">

            <div class="service-info-heading">

                <p class="section-eyebrow">The Cleaning Approach</p>

                <h2>Cleaning That Accounts for the Surface</h2>

            </div>


            <div class="service-method-content">

                <p>
                    Storefronts can combine multiple exterior materials
                    within a relatively small area. Walls, entrances,
                    walking surfaces, trim, and other exterior features
                    may not all require the same cleaning method.
                </p>

                <p>
                    The appropriate approach should account for the material,
                    its condition, any existing finish, and the type of
                    buildup being addressed.
                </p>

                <p>
                    Evaluating those factors helps determine an appropriate
                    cleaning method for each qualifying area included in
                    the project.
                </p>

            </div>

        </section>


        <!-- BENEFITS -->

        <section class="service-info-section service-info-split">

            <div>

                <p class="section-eyebrow">Storefront Appearance</p>

                <h2>Keep Your Business Looking Welcoming</h2>

            </div>


            <div class="service-info-copy">

                <p>
                    Customers begin forming an impression of a business
                    before they walk through the door. Exterior cleaning
                    can help maintain the appearance of the areas they
                    encounter first.
                </p>

                <ul class="service-check-list">

                    <li>Refreshes customer-facing exterior surfaces</li>
                    <li>Addresses suitable dirt and organic buildup</li>
                    <li>Improves the appearance of entrances and visible areas</li>
                    <li>Supports ongoing exterior property maintenance</li>
                    <li>Helps keep frequently seen areas looking cared for</li>

                </ul>

                <p>
                    Exterior storefront cleaning does not replace repairs,
                    repainting, restoration, or replacement of damaged
                    materials and finishes.
                </p>

            </div>

        </section>


        <!-- PROCESS -->

        <section class="service-info-section">

            <div class="service-info-heading">

                <p class="section-eyebrow">What to Expect</p>

                <h2>Our Storefront Cleaning Process</h2>

                <p>
                    Every storefront is different. The materials, condition,
                    accessibility, and areas included in the project help
                    determine the appropriate cleaning plan.
                </p>

            </div>


            <div class="service-process-grid">

                <div class="service-process-step">

                    <span>01</span>

                    <h3>Discuss Your Storefront</h3>

                    <p>
                        Tell us about the property, the areas you would like
                        cleaned, and any specific exterior concerns.
                    </p>

                </div>


                <div class="service-process-step">

                    <span>02</span>

                    <h3>Evaluate the Surfaces</h3>

                    <p>
                        Consider the materials, condition, accessibility,
                        and buildup before determining an appropriate
                        cleaning approach.
                    </p>

                </div>


                <div class="service-process-step">

                    <span>03</span>

                    <h3>Perform the Cleaning</h3>

                    <p>
                        Address the agreed-upon exterior areas using methods
                        appropriate for the surfaces and their condition.
                    </p>

                </div>


                <div class="service-process-step">

                    <span>04</span>

                    <h3>Review the Results</h3>

                    <p>
                        Review the cleaned areas and discuss any remaining
                        staining, weathering, or exterior surface concerns.
                    </p>

                </div>

            </div>

        </section>


        <!-- FAQ -->

        <ServiceFAQ faqs={faqs} />

    </div>

</ServiceLayout>