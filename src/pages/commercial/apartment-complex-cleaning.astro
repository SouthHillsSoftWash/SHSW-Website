---
import ServiceLayout from "../../layouts/ServiceLayout.astro";
import ServiceFAQ from "../../components/ServiceFAQ.astro";

const faqs = [
    {
        question: "What areas of an apartment complex can be cleaned?",
        answer: "Depending on the property, cleaning may include qualifying building exteriors, entrances, walkways, common exterior areas, and other surfaces included in the agreed-upon scope."
    },
    {
        question: "Can multiple buildings be included in one project?",
        answer: "For properties with multiple buildings, the requested buildings and areas can be discussed when determining the scope of work."
    },
    {
        question: "Do different building materials require different cleaning methods?",
        answer: "Yes. Exterior materials can have different cleaning requirements, so the appropriate approach should account for the material, finish, condition, and type of buildup present."
    },
    {
        question: "Can you clean exterior common areas?",
        answer: "Qualifying common exterior areas may be included depending on their materials, condition, accessibility, and the agreed-upon project scope."
    },
    {
        question: "Will exterior cleaning repair damaged siding or other materials?",
        answer: "No. Cleaning does not repair damaged siding, deteriorated coatings, structural defects, or other damaged exterior materials."
    },
    {
        question: "How often should apartment exteriors be cleaned?",
        answer: "Cleaning frequency depends on building materials, moisture, shade, surrounding vegetation, traffic, environmental exposure, and property maintenance goals."
    },
    {
        question: "Can specific buildings or areas be prioritized?",
        answer: "If certain buildings or exterior areas need more attention, identify them when requesting a quote so the requested scope can be evaluated."
    },
    {
        question: "How do I request an apartment complex cleaning quote?",
        answer: "Contact South Hills Soft Wash with information about the property, number of buildings or areas involved, requested surfaces, and any specific exterior concerns."
    }
];
---

<ServiceLayout
    title="Apartment Complex Cleaning"
    seoTitle="Apartment Complex Exterior Cleaning"
    description="Exterior cleaning for qualifying apartment buildings and shared outdoor areas to help maintain a cleaner, more cared-for property."
    image="/images/commercial/apartment_complex.jpg"
    seoDescription="Exterior cleaning for apartment complexes from South Hills Soft Wash, serving multifamily properties throughout the South Hills and surrounding Pittsburgh communities."
    category="Commercial"
>

    <p class="section-eyebrow">Multi-Unit Properties</p>

    <h2>Exterior Cleaning Across Your Property</h2>

    <p>
        Apartment communities can include multiple buildings, entrances,
        walkways, and shared exterior areas, all exposed to weather and
        everyday activity.
    </p>

    <p>
        Exterior apartment complex cleaning can address suitable buildup
        throughout qualifying areas while accounting for the different
        materials and conditions found across the property.
    </p>


    <div slot="extra">

        <section class="service-info-section">

            <div class="service-info-heading">
                <p class="section-eyebrow">Throughout the Property</p>
                <h2>Cleaning for Multi-Unit Communities</h2>
                <p>
                    Different portions of an apartment property can experience
                    different levels of traffic, moisture, shade, and
                    environmental exposure.
                </p>
            </div>

            <div class="service-info-grid">

                <div class="service-info-card">
                    <span>01</span>
                    <h3>Building Exteriors</h3>
                    <p>
                        Addressing suitable buildup across compatible exterior
                        building surfaces.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>02</span>
                    <h3>Entrances</h3>
                    <p>
                        Refreshing qualifying exterior surfaces around
                        frequently used building entrances.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>03</span>
                    <h3>Walkways</h3>
                    <p>
                        Addressing compatible walking surfaces affected by
                        foot traffic and outdoor exposure.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>04</span>
                    <h3>Shared Exterior Areas</h3>
                    <p>
                        Including applicable common outdoor surfaces when
                        they are part of the agreed-upon project.
                    </p>
                </div>

            </div>
        </section>


        <section class="service-info-section service-info-split">

            <div>
                <p class="section-eyebrow">Common Property Concerns</p>
                <h2>Outdoor Exposure Affects the Whole Community</h2>
            </div>

            <div class="service-info-copy">

                <p>
                    Multi-unit properties experience a combination of resident
                    traffic, changing weather, moisture, vegetation, and
                    environmental debris.
                </p>

                <ul class="service-check-list">
                    <li>Dirt and exterior grime</li>
                    <li>Green algae and organic buildup</li>
                    <li>Dark discoloration in shaded areas</li>
                    <li>Pollen and seasonal debris</li>
                    <li>High-traffic surface buildup</li>
                    <li>Weather-related discoloration</li>
                </ul>

                <p>
                    Permanent staining, oxidation, deteriorated finishes,
                    damaged materials, and other underlying conditions may
                    remain after cleaning.
                </p>

            </div>
        </section>


        <section class="service-info-section service-method-section">

            <div class="service-info-heading">
                <p class="section-eyebrow">The Cleaning Approach</p>
                <h2>Every Building and Surface Is Different</h2>
            </div>

            <div class="service-method-content">

                <p>
                    Apartment properties may contain several building
                    materials and exterior surface types throughout the
                    community.
                </p>

                <p>
                    Cleaning methods should account for the material,
                    existing finish, condition, accessibility, and type
                    of buildup present.
                </p>

                <p>
                    The requested buildings and exterior areas can be
                    evaluated when establishing the scope of work.
                </p>

            </div>
        </section>


        <section class="service-info-section service-info-split">

            <div>
                <p class="section-eyebrow">Property Appearance</p>
                <h2>Maintain a Cleaner-Looking Community</h2>
            </div>

            <div class="service-info-copy">

                <p>
                    Building exteriors and shared outdoor areas contribute
                    to the overall appearance residents, prospective tenants,
                    employees, and visitors experience throughout a property.
                </p>

                <ul class="service-check-list">
                    <li>Refreshes qualifying building exteriors</li>
                    <li>Addresses suitable dirt and organic buildup</li>
                    <li>Improves the appearance of common exterior areas</li>
                    <li>Supports ongoing exterior property maintenance</li>
                    <li>Creates a more consistent appearance across the property</li>
                </ul>

                <p>
                    Exterior cleaning does not replace repairs, painting,
                    restoration, or replacement of damaged property features.
                </p>

            </div>
        </section>


        <section class="service-info-section">

            <div class="service-info-heading">
                <p class="section-eyebrow">What to Expect</p>
                <h2>Our Apartment Exterior Cleaning Process</h2>
                <p>
                    Property size, materials, condition, accessibility,
                    and requested areas help determine the cleaning plan.
                </p>
            </div>

            <div class="service-process-grid">

                <div class="service-process-step">
                    <span>01</span>
                    <h3>Discuss the Property</h3>
                    <p>
                        Identify the buildings, exterior areas, and specific
                        concerns included in the request.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>02</span>
                    <h3>Evaluate the Surfaces</h3>
                    <p>
                        Consider the materials, condition, accessibility,
                        and buildup throughout the requested areas.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>03</span>
                    <h3>Perform the Cleaning</h3>
                    <p>
                        Address agreed-upon areas using methods appropriate
                        for the qualifying surfaces.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>04</span>
                    <h3>Review the Results</h3>
                    <p>
                        Review the cleaned areas and discuss remaining
                        staining or surface concerns where applicable.
                    </p>
                </div>

            </div>
        </section>


        <ServiceFAQ faqs={faqs} />

    </div>

</ServiceLayout>