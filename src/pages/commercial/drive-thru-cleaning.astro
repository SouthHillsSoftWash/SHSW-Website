---
import ServiceLayout from "../../layouts/ServiceLayout.astro";
import ServiceFAQ from "../../components/ServiceFAQ.astro";

const faqs = [
    {
        question: "What areas of a drive-thru can be cleaned?",
        answer: "Depending on the property, cleaning may include qualifying pavement, exterior walls, curbs, pickup areas, and other exterior surfaces within the drive-thru. The requested areas can be evaluated when determining the scope of work.",
    },
    {
        question: "Can you address grease and food-related buildup?",
        answer: "Some food, beverage, grease, and traffic-related buildup may respond to exterior cleaning, but results depend on the contaminant, surface material, age of the staining, and condition of the surface.",
    },
    {
        question: "Can you remove tire marks?",
        answer: "Some vehicle-related marks and surface buildup may be improved through cleaning. Complete removal cannot be assumed because results vary according to the pavement, severity, and age of the marking.",
    },
    {
        question: "Do you clean drive-thru walls and curbs too?",
        answer: "Additional qualifying exterior surfaces can be discussed when requesting a quote. Different materials may require different cleaning methods.",
    },
    {
        question: "Will cleaning remove every stain?",
        answer: "No. Permanent staining, damaged surfaces, embedded contaminants, weathering, and material changes may remain after cleaning.",
    },
    {
        question: "How often should a drive-thru be cleaned?",
        answer: "Cleaning frequency depends on vehicle volume, food and beverage activity, weather, pavement material, surrounding conditions, and the appearance standards of the property.",
    },
    {
        question: "Can only the highest-traffic areas be cleaned?",
        answer: "Specific areas can be discussed when requesting your quote. The requested surfaces can then be evaluated to determine an appropriate scope of work.",
    },
    {
        question: "How do I request a drive-thru cleaning quote?",
        answer: "Contact South Hills Soft Wash with information about the property, the areas needing attention, and any particular buildup or staining concerns. Photos can also help communicate the requested work.",
    },
];
---

<ServiceLayout
    title="Drive-Thru Cleaning"
    seoTitle="Drive-Thru Cleaning"
    description="Exterior cleaning for high-traffic drive-thru areas affected by vehicles, weather, spills, and everyday commercial activity."
    image="/images/commercial/drivethru.png"
    seoDescription="Professional drive-thru exterior cleaning from South Hills Soft Wash for commercial properties throughout the South Hills and surrounding Pittsburgh communities."
    category="Commercial"
>
    <p class="section-eyebrow">Commercial Drive-Thru Cleaning</p>

    <h2>Clean Up a High-Traffic Part of Your Property</h2>

    <p>
        Drive-thrus experience constant vehicle traffic along with weather,
        spills, debris, and everyday commercial activity. Over time, that
        exposure can leave pavement and surrounding exterior surfaces visibly
        dirty or stained.
    </p>

    <p>
        Drive-thru cleaning can address suitable exterior buildup throughout
        these heavily used areas while accounting for the different surfaces and
        conditions found around the property.
    </p>

    <div slot="extra">
        <!-- ============================================
         DRIVE-THRU AREAS
        ============================================= -->

        <section class="service-info-section">
            <div class="service-info-heading">
                <p class="section-eyebrow">High-Traffic Areas</p>
                <h2>Cleaning Beyond the Drive Lane</h2>
                <p>
                    A drive-thru can contain several exterior surfaces affected
                    by different types of traffic and buildup.
                </p>
            </div>

            <div class="service-info-grid">
                <div class="service-info-card">
                    <span>01</span>
                    <h3>Drive Lanes</h3>
                    <p>
                        Addressing suitable dirt and vehicle-related buildup
                        across compatible paved driving surfaces.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>02</span>
                    <h3>Pickup Areas</h3>
                    <p>
                        Cleaning qualifying exterior surfaces around areas where
                        vehicles regularly stop and customers receive their
                        orders.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>03</span>
                    <h3>Curbs & Edges</h3>
                    <p>
                        Addressing applicable buildup along compatible curbs,
                        edges, and surrounding hard surfaces.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>04</span>
                    <h3>Adjacent Exterior Surfaces</h3>
                    <p>
                        Including qualifying nearby walls or other exterior
                        areas when they are part of the agreed-upon project.
                    </p>
                </div>
            </div>
        </section>

        <!-- ============================================
         COMMON BUILDUP
        ============================================= -->

        <section class="service-info-section service-info-split">
            <div>
                <p class="section-eyebrow">Common Drive-Thru Concerns</p>
                <h2>Heavy Use Leaves Its Mark</h2>
            </div>

            <div class="service-info-copy">
                <p>
                    Drive-thru areas combine frequent vehicle traffic with
                    food-service activity and constant outdoor exposure.
                </p>

                <ul class="service-check-list">
                    <li>Dirt and roadway grime</li>
                    <li>Food and beverage spills</li>
                    <li>Suitable grease-related buildup</li>
                    <li>Vehicle-related surface marks</li>
                    <li>Organic and environmental buildup</li>
                    <li>Seasonal debris</li>
                </ul>

                <p>
                    Some stains may become embedded in pavement or result from
                    permanent surface changes. Cleaning can improve applicable
                    buildup without guaranteeing complete stain removal.
                </p>
            </div>
        </section>

        <!-- ============================================
         APPROACH
        ============================================= -->

        <section class="service-info-section service-method-section">
            <div class="service-info-heading">
                <p class="section-eyebrow">The Cleaning Approach</p>
                <h2>Cleaning for a Busy Commercial Environment</h2>
            </div>

            <div class="service-method-content">
                <p>
                    Drive-thru areas may combine pavement, curbs, painted
                    surfaces, building materials, and other exterior features.
                </p>

                <p>
                    The appropriate cleaning approach should account for the
                    surface, its condition, and the type of buildup being
                    addressed.
                </p>

                <p>
                    The requested areas can be evaluated individually when
                    determining the cleaning plan for the property.
                </p>
            </div>
        </section>

        <!-- ============================================
         BENEFITS
        ============================================= -->

        <section class="service-info-section service-info-split">
            <div>
                <p class="section-eyebrow">Property Appearance</p>
                <h2>Give a Busy Area the Attention It Needs</h2>
            </div>

            <div class="service-info-copy">
                <p>
                    For businesses with drive-thru service, this area is part of
                    the customer experience and one of the most frequently used
                    exterior portions of the property.
                </p>

                <ul class="service-check-list">
                    <li>Refreshes high-traffic exterior areas</li>
                    <li>Addresses suitable spills and surface buildup</li>
                    <li>Improves the appearance of drive lanes</li>
                    <li>Complements exterior building cleaning</li>
                    <li>Supports ongoing exterior property maintenance</li>
                </ul>

                <p>
                    Cleaning does not replace pavement repair, resurfacing,
                    repainting, or repair of damaged exterior materials.
                </p>
            </div>
        </section>

        <!-- ============================================
         PROCESS
        ============================================= -->

        <section class="service-info-section">
            <div class="service-info-heading">
                <p class="section-eyebrow">What to Expect</p>
                <h2>Our Drive-Thru Cleaning Process</h2>
                <p>
                    The surfaces, condition, accessibility, and requested
                    cleaning areas help determine the appropriate plan.
                </p>
            </div>

            <div class="service-process-grid">
                <div class="service-process-step">
                    <span>01</span>
                    <h3>Discuss the Property</h3>
                    <p>
                        Identify the drive-thru areas and specific exterior
                        concerns you would like addressed.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>02</span>
                    <h3>Evaluate the Areas</h3>
                    <p>
                        Consider the surfaces, condition, accessibility, and
                        type of buildup present.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>03</span>
                    <h3>Perform the Cleaning</h3>
                    <p>
                        Address the agreed-upon areas using methods appropriate
                        for the applicable surfaces.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>04</span>
                    <h3>Review the Results</h3>
                    <p>
                        Review the cleaned areas and discuss remaining stains or
                        surface concerns where applicable.
                    </p>
                </div>
            </div>
        </section>

        <!-- ============================================
         FAQ
        ============================================= -->
        <ServiceFAQ faqs={faqs} />
    </div>
</ServiceLayout>
