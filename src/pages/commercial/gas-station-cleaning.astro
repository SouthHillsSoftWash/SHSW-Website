---
import ServiceLayout from "../../layouts/ServiceLayout.astro";
import ServiceFAQ from "../../components/ServiceFAQ.astro";

const faqs = [
    {
        question: "What exterior areas of a gas station can be cleaned?",
        answer: "Depending on the property, qualifying building exteriors, pavement, walkways, curbs, and other outdoor surfaces may be considered as part of the requested scope.",
    },
    {
        question: "Can you remove oil and vehicle-fluid stains?",
        answer: "Some oil and vehicle-fluid-related staining may improve through appropriate cleaning, but complete removal cannot be assumed. Results depend on the contaminant, surface, age of the stain, and depth of penetration.",
    },
    {
        question: "Can you clean around fuel dispensing areas?",
        answer: "Fuel-service properties can have site-specific requirements and sensitive areas. Any requested cleaning around fuel dispensing or related equipment would need to be evaluated for suitability before being included in the scope.",
    },
    {
        question: "Will cleaning remove every pavement stain?",
        answer: "No. Porous surfaces may retain permanent staining, and damaged or weathered materials cannot be restored through cleaning alone.",
    },
    {
        question: "Can building exteriors be included?",
        answer: "Qualifying exterior building surfaces may be included depending on their material, condition, accessibility, and the agreed-upon project scope.",
    },
    {
        question: "How often should a gas station property be cleaned?",
        answer: "Cleaning frequency depends on traffic volume, property use, weather, surface materials, surrounding conditions, and the property's maintenance needs.",
    },
    {
        question: "Can specific high-traffic areas be prioritized?",
        answer: "Yes, requested areas can be identified when seeking a quote and evaluated individually when determining the project scope.",
    },
    {
        question: "How do I request a gas station cleaning quote?",
        answer: "Contact South Hills Soft Wash with information about the property, requested exterior areas, and specific buildup or staining concerns. Photos can help communicate the requested scope.",
    },
];
---

<ServiceLayout
    title="Gas Station Cleaning"
    seoTitle="Gas Station Exterior Cleaning"
    description="Exterior cleaning for qualifying gas station surfaces and high-traffic outdoor areas affected by vehicles, weather, spills, and everyday use."
    image="/images/commercial/gas_station.png"
    seoDescription="Exterior cleaning for gas stations from South Hills Soft Wash, serving commercial properties throughout the South Hills and surrounding Pittsburgh communities."
    category="Commercial"
>
    <p class="section-eyebrow">Commercial Gas Station Cleaning</p>

    <h2>Exterior Cleaning for a High-Traffic Property</h2>

    <p>
        Gas station properties experience frequent vehicle and pedestrian
        traffic along with continuous outdoor exposure. Pavement, building
        exteriors, and surrounding areas can accumulate visible grime and
        staining over time.
    </p>

    <p>
        Cleaning qualifying exterior surfaces can help address applicable
        buildup while accounting for the materials, condition, and site-specific
        considerations of the property.
    </p>

    <div slot="extra">
        <!-- ============================================
         EXTERIOR AREAS
        ============================================= -->
        <section class="service-info-section">
            <div class="service-info-heading">
                <p class="section-eyebrow">Exterior Areas</p>
                <h2>Cleaning Throughout the Property</h2>
                <p>
                    Gas station properties contain several exterior areas with
                    different materials, traffic patterns, and cleaning
                    considerations.
                </p>
            </div>

            <div class="service-info-grid">
                <div class="service-info-card">
                    <span>01</span>
                    <h3>Building Exteriors</h3>
                    <p>
                        Addressing suitable buildup across compatible exterior
                        building surfaces.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>02</span>
                    <h3>Paved Areas</h3>
                    <p>
                        Cleaning qualifying hard surfaces affected by frequent
                        vehicle activity and environmental grime.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>03</span>
                    <h3>Walkways & Curbs</h3>
                    <p>
                        Addressing compatible pedestrian areas and curbs
                        included in the agreed-upon project.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>04</span>
                    <h3>High-Traffic Areas</h3>
                    <p>
                        Focusing on qualifying exterior surfaces experiencing
                        frequent customer and vehicle activity.
                    </p>
                </div>
            </div>
        </section>

        <!-- ============================================
         COMMON PROPERTY CONCERNS
        ============================================= -->
        <section class="service-info-section service-info-split">
            <div>
                <p class="section-eyebrow">Common Property Concerns</p>
                <h2>Constant Traffic Creates Buildup</h2>
            </div>

            <div class="service-info-copy">
                <p>
                    Vehicle traffic, pedestrians, changing weather, roadway
                    debris, and everyday commercial use can affect the
                    appearance of exterior surfaces.
                </p>

                <ul class="service-check-list">
                    <li>Dirt and roadway grime</li>
                    <li>Vehicle-related surface buildup</li>
                    <li>Suitable oil and fluid-related staining</li>
                    <li>Food and beverage spills</li>
                    <li>Organic and environmental buildup</li>
                    <li>Seasonal debris</li>
                </ul>

                <p>
                    Some contaminants may penetrate porous surfaces or create
                    permanent staining. Cleaning may improve applicable buildup
                    without guaranteeing complete removal.
                </p>
            </div>
        </section>

        <!-- ============================================
         CLEANING APPROACH
        ============================================= -->
        <section class="service-info-section service-method-section">
            <div class="service-info-heading">
                <p class="section-eyebrow">The Cleaning Approach</p>
                <h2>Site Conditions Matter</h2>
            </div>

            <div class="service-method-content">
                <p>
                    Gas station properties can include sensitive equipment,
                    multiple surface materials, and property-specific operating
                    requirements.
                </p>

                <p>
                    Requested areas should be evaluated according to the
                    material, condition, buildup, accessibility, and any
                    relevant site considerations before determining a cleaning
                    approach.
                </p>

                <p>
                    Areas associated with fuel equipment or other specialized
                    property features require particular consideration before
                    being included in a cleaning scope.
                </p>
            </div>
        </section>

        <!-- ============================================
         PROPERTY APPEARANCE
        ============================================= -->
        <section class="service-info-section service-info-split">
            <div>
                <p class="section-eyebrow">Property Appearance</p>
                <h2>Maintain a Cleaner-Looking Exterior</h2>
            </div>

            <div class="service-info-copy">
                <p>
                    A gas station exterior is used by a large number of
                    customers and vehicles, making routine exterior upkeep
                    particularly visible.
                </p>

                <ul class="service-check-list">
                    <li>Refreshes qualifying high-traffic surfaces</li>
                    <li>Addresses suitable roadway and exterior grime</li>
                    <li>Improves the appearance of customer-facing areas</li>
                    <li>Complements exterior building cleaning</li>
                    <li>Supports ongoing exterior property maintenance</li>
                </ul>

                <p>
                    Cleaning does not replace pavement repair, equipment
                    maintenance, environmental remediation, or restoration of
                    damaged exterior materials.
                </p>
            </div>
        </section>

        <!-- ============================================
         PROCESS
        ============================================= -->
        <section class="service-info-section">
            <div class="service-info-heading">
                <p class="section-eyebrow">What to Expect</p>
                <h2>Our Gas Station Cleaning Process</h2>
                <p>
                    Property layout, surface types, accessibility, and requested
                    areas help determine the appropriate scope.
                </p>
            </div>

            <div class="service-process-grid">
                <div class="service-process-step">
                    <span>01</span>
                    <h3>Discuss the Property</h3>
                    <p>
                        Identify the exterior areas and specific concerns
                        included in the cleaning request.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>02</span>
                    <h3>Evaluate the Site</h3>
                    <p>
                        Consider surfaces, condition, accessibility, buildup,
                        and relevant site-specific factors.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>03</span>
                    <h3>Perform the Cleaning</h3>
                    <p>
                        Address agreed-upon qualifying areas using methods
                        appropriate for the surfaces.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>04</span>
                    <h3>Review the Results</h3>
                    <p>
                        Review cleaned areas and discuss remaining staining or
                        exterior surface concerns.
                    </p>
                </div>
            </div>
        </section>

        <!-- ============================================
         FAQ
        ============================================= -->
        <ServiceFAQ faqs={faqs} />
    </div>
</ServiceLayout>
