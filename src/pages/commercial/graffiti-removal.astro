---
import ServiceLayout from "../../layouts/ServiceLayout.astro";
import ServiceFAQ from "../../components/ServiceFAQ.astro";

const faqs = [
    {
        question: "What types of surfaces can graffiti be removed from?",
        answer: "Graffiti removal depends heavily on the affected material and its condition. Masonry, concrete, painted surfaces, and other materials can respond differently, so the surface should be evaluated before determining whether removal is appropriate."
    },
    {
        question: "Can all graffiti be completely removed?",
        answer: "Complete removal cannot be guaranteed. Results depend on the marking material, affected surface, porosity, age of the graffiti, previous coatings, and whether staining or surface damage has occurred."
    },
    {
        question: "Does the type of paint or marker matter?",
        answer: "Yes. Different paints, inks, markers, and other materials can behave differently during removal and may require different approaches."
    },
    {
        question: "Can graffiti removal affect the surface underneath?",
        answer: "The underlying material and finish are important considerations. Some surfaces or coatings may already be damaged, faded, weathered, or affected by the graffiti itself, and aggressive removal methods can create additional surface changes."
    },
    {
        question: "Can graffiti be removed from painted walls?",
        answer: "Painted surfaces require careful evaluation because a removal process may affect the underlying coating. In some cases, repainting or restoration may be a separate or more appropriate solution."
    },
    {
        question: "Does older graffiti become harder to remove?",
        answer: "Age can be one factor affecting removal, along with the marking material, porosity of the surface, weather exposure, and underlying finish."
    },
    {
        question: "Will the area look exactly like it did before the graffiti?",
        answer: "Not necessarily. Even when the marking is improved or removed, differences in weathering, color, coating condition, ghosting, or permanent staining may remain."
    },
    {
        question: "How do I request a graffiti removal quote?",
        answer: "Contact South Hills Soft Wash with photos of the affected area and information about the surface if known. The material and condition can then be evaluated before determining an appropriate scope of work."
    }
];
---

<ServiceLayout
    title="Graffiti Removal"
    seoTitle="Commercial Graffiti Removal"
    description="Graffiti removal for qualifying exterior surfaces, with the cleaning approach selected according to the affected material, condition, and type of marking."
    image="/images/commercial/graffiti.jpg"
    seoDescription="Commercial graffiti removal from South Hills Soft Wash for businesses and properties throughout the South Hills and surrounding Pittsburgh communities."
    category="Commercial"
>

    <p class="section-eyebrow">Commercial Graffiti Removal</p>

    <h2>Address Unwanted Exterior Markings</h2>

    <p>
        Graffiti can affect many different exterior materials, and removing
        it is not a one-method-fits-all process. The marking itself and the
        surface underneath both influence the appropriate approach.
    </p>

    <p>
        Graffiti removal begins with evaluating the affected material,
        condition, and type of marking to determine whether cleaning is
        appropriate and what limitations may apply.
    </p>


    <div slot="extra">

        <section class="service-info-section">

            <div class="service-info-heading">
                <p class="section-eyebrow">Surface Considerations</p>
                <h2>The Material Underneath Matters</h2>
                <p>
                    Different exterior surfaces respond differently to
                    graffiti and the methods used to address it.
                </p>
            </div>

            <div class="service-info-grid">

                <div class="service-info-card">
                    <span>01</span>
                    <h3>Masonry</h3>
                    <p>
                        Porous masonry can allow marking materials to
                        penetrate below the immediate surface.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>02</span>
                    <h3>Concrete</h3>
                    <p>
                        Concrete condition, porosity, finish, and the type
                        of marking can all influence removal results.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>03</span>
                    <h3>Painted Surfaces</h3>
                    <p>
                        Existing paint and coatings require careful
                        consideration because removal methods may affect
                        the underlying finish.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>04</span>
                    <h3>Other Exterior Materials</h3>
                    <p>
                        Other qualifying materials should be evaluated
                        individually before selecting a removal approach.
                    </p>
                </div>

            </div>
        </section>


        <section class="service-info-section service-info-split">

            <div>
                <p class="section-eyebrow">Removal Factors</p>
                <h2>Why Results Can Vary</h2>
            </div>

            <div class="service-info-copy">

                <p>
                    Graffiti removal depends on more than what is visible
                    on the surface. Several factors can influence how well
                    a marking responds.
                </p>

                <ul class="service-check-list">
                    <li>Type of paint, ink, or marking material</li>
                    <li>Age of the graffiti</li>
                    <li>Surface porosity</li>
                    <li>Existing paint or coatings</li>
                    <li>Weathering and previous surface condition</li>
                    <li>Depth of staining or penetration</li>
                </ul>

                <p>
                    Ghosting, permanent staining, coating changes, or
                    differences in weathering may remain even after the
                    marking has been substantially improved.
                </p>

            </div>
        </section>


        <section class="service-info-section service-method-section">

            <div class="service-info-heading">
                <p class="section-eyebrow">The Removal Approach</p>
                <h2>Evaluate Before Treating</h2>
            </div>

            <div class="service-method-content">

                <p>
                    An aggressive method that works on one material may
                    damage another. For that reason, the underlying surface
                    should be considered before selecting an approach.
                </p>

                <p>
                    Existing coatings, weathering, porosity, and the type
                    of graffiti can all influence what methods are
                    appropriate.
                </p>

                <p>
                    In some situations, complete restoration may require
                    services beyond cleaning, such as repainting or repair.
                </p>

            </div>
        </section>


        <section class="service-info-section service-info-split">

            <div>
                <p class="section-eyebrow">Exterior Appearance</p>
                <h2>Address Graffiti Without Making Empty Promises</h2>
            </div>

            <div class="service-info-copy">

                <p>
                    Appropriate graffiti removal can significantly improve
                    an affected area, but the realistic result depends on
                    the marking and the material underneath.
                </p>

                <ul class="service-check-list">
                    <li>Addresses qualifying unwanted markings</li>
                    <li>Accounts for the underlying surface</li>
                    <li>Can improve affected exterior areas</li>
                    <li>Identifies situations where staining may remain</li>
                    <li>Helps determine when other restoration may be needed</li>
                </ul>

                <p>
                    Graffiti removal does not guarantee restoration to the
                    exact pre-graffiti appearance of the surface.
                </p>

            </div>
        </section>


        <section class="service-info-section">

            <div class="service-info-heading">
                <p class="section-eyebrow">What to Expect</p>
                <h2>Our Graffiti Removal Process</h2>
                <p>
                    The marking and underlying material should be evaluated
                    before determining an appropriate removal approach.
                </p>
            </div>

            <div class="service-process-grid">

                <div class="service-process-step">
                    <span>01</span>
                    <h3>Document the Area</h3>
                    <p>
                        Provide information and photos showing the affected
                        surface and extent of the marking.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>02</span>
                    <h3>Evaluate the Surface</h3>
                    <p>
                        Consider the material, finish, condition, and type
                        of graffiti present.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>03</span>
                    <h3>Address the Marking</h3>
                    <p>
                        Use an appropriate approach for qualifying surfaces
                        and the agreed-upon scope.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>04</span>
                    <h3>Review the Results</h3>
                    <p>
                        Evaluate remaining ghosting, staining, coating
                        changes, or other surface concerns.
                    </p>
                </div>

            </div>
        </section>


        <ServiceFAQ faqs={faqs} />

    </div>

</ServiceLayout>