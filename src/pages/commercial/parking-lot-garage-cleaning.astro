---
import ServiceLayout from "../../layouts/ServiceLayout.astro";
import ServiceFAQ from "../../components/ServiceFAQ.astro";

const faqs = [
    {
        question: "What parking areas can be cleaned?",
        answer: "Depending on the property and surface condition, cleaning may include qualifying parking surfaces, driving lanes, pedestrian areas, curbs, and other exterior hard surfaces included in the agreed-upon scope."
    },
    {
        question: "Can you clean parking garages?",
        answer: "Qualifying parking garage surfaces may be appropriate for cleaning depending on the materials, drainage, accessibility, property requirements, and type of buildup present."
    },
    {
        question: "Can cleaning remove oil stains?",
        answer: "Some vehicle-fluid and oil-related staining may improve with appropriate cleaning, but complete removal cannot be assumed. Results depend on the surface, contaminant, age of the stain, and how deeply it has penetrated."
    },
    {
        question: "Can tire marks be removed?",
        answer: "Some vehicle-related markings may respond to cleaning. Results vary according to the surface material, age and severity of the marking, and underlying condition."
    },
    {
        question: "Will cleaning repair damaged pavement or concrete?",
        answer: "No. Cleaning does not repair cracking, spalling, deterioration, damaged coatings, or other structural and surface defects."
    },
    {
        question: "How often should parking areas be cleaned?",
        answer: "Cleaning frequency depends on traffic volume, weather exposure, surrounding conditions, surface material, and the maintenance needs of the property."
    },
    {
        question: "Can only certain areas of a parking facility be cleaned?",
        answer: "Specific high-traffic or problem areas can be discussed when requesting a quote. The requested surfaces can be evaluated to determine an appropriate project scope."
    },
    {
        question: "How do I request a parking lot or garage cleaning quote?",
        answer: "Contact South Hills Soft Wash with information about the property, approximate areas needing cleaning, surface types if known, and specific buildup or staining concerns."
    }
];
---

<ServiceLayout
    title="Parking Lot & Garage Cleaning"
    description="Exterior cleaning for qualifying parking lots, garages, and high-traffic paved areas affected by vehicles, weather, and everyday use."
    image="/images/commercial/parking_garage.jpg"
    category="Commercial"
>

    <p class="section-eyebrow">Commercial Parking Areas</p>

    <h2>Refresh the Surfaces Your Property Uses Every Day</h2>

    <p>
        Parking areas experience constant vehicle and pedestrian traffic,
        exposure to weather, and environmental debris. These conditions can
        lead to visible grime and buildup across heavily used surfaces.
    </p>

    <p>
        Cleaning qualifying parking lot and garage surfaces can help address
        applicable buildup while accounting for the material, condition, and
        needs of the property.
    </p>


    <div slot="extra">

        <section class="service-info-section">

            <div class="service-info-heading">
                <p class="section-eyebrow">Parking Areas</p>
                <h2>Cleaning High-Traffic Surfaces</h2>
                <p>
                    Parking facilities include more than parking spaces.
                    Different areas may experience different traffic,
                    exposure, and cleaning needs.
                </p>
            </div>

            <div class="service-info-grid">

                <div class="service-info-card">
                    <span>01</span>
                    <h3>Parking Surfaces</h3>
                    <p>
                        Addressing suitable grime and buildup across compatible
                        parking surfaces.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>02</span>
                    <h3>Driving Areas</h3>
                    <p>
                        Cleaning qualifying surfaces exposed to frequent
                        vehicle movement and roadway debris.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>03</span>
                    <h3>Pedestrian Areas</h3>
                    <p>
                        Addressing compatible walking areas within or around
                        parking facilities where included in the project.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>04</span>
                    <h3>Curbs & Perimeter Areas</h3>
                    <p>
                        Including applicable curbs, edges, and surrounding
                        hard surfaces when appropriate.
                    </p>
                </div>

            </div>
        </section>


        <section class="service-info-section service-info-split">

            <div>
                <p class="section-eyebrow">Common Parking Concerns</p>
                <h2>Vehicle Traffic Creates Constant Buildup</h2>
            </div>

            <div class="service-info-copy">

                <p>
                    Parking facilities are exposed to vehicles, pedestrians,
                    changing weather, debris, and contaminants associated
                    with everyday use.
                </p>

                <ul class="service-check-list">
                    <li>Dirt and roadway grime</li>
                    <li>Vehicle-related surface buildup</li>
                    <li>Suitable oil and fluid-related staining</li>
                    <li>Organic and environmental buildup</li>
                    <li>Seasonal debris</li>
                    <li>High-traffic discoloration</li>
                </ul>

                <p>
                    Some stains can penetrate porous surfaces or become
                    permanent over time. Cleaning may improve applicable
                    staining without completely removing it.
                </p>

            </div>
        </section>


        <section class="service-info-section service-method-section">

            <div class="service-info-heading">
                <p class="section-eyebrow">The Cleaning Approach</p>
                <h2>The Surface and Site Matter</h2>
            </div>

            <div class="service-method-content">

                <p>
                    Parking areas can vary significantly in material,
                    condition, accessibility, drainage, coatings, and
                    surrounding property features.
                </p>

                <p>
                    Those factors should be considered along with the type
                    of buildup when determining an appropriate cleaning
                    approach.
                </p>

                <p>
                    Parking garages may also have property-specific
                    considerations that should be evaluated before work
                    begins.
                </p>

            </div>
        </section>


        <section class="service-info-section service-info-split">

            <div>
                <p class="section-eyebrow">Property Maintenance</p>
                <h2>Give High-Use Areas a Cleaner Appearance</h2>
            </div>

            <div class="service-info-copy">

                <p>
                    Parking areas are often among the first and last parts
                    of a commercial property used by customers, tenants,
                    employees, and visitors.
                </p>

                <ul class="service-check-list">
                    <li>Addresses suitable traffic-related buildup</li>
                    <li>Refreshes qualifying parking surfaces</li>
                    <li>Improves the appearance of high-use areas</li>
                    <li>Complements surrounding exterior cleaning</li>
                    <li>Supports routine property upkeep</li>
                </ul>

                <p>
                    Cleaning does not replace pavement or concrete repair,
                    resurfacing, coating restoration, or other structural
                    maintenance.
                </p>

            </div>
        </section>


        <section class="service-info-section">

            <div class="service-info-heading">
                <p class="section-eyebrow">What to Expect</p>
                <h2>Our Parking Area Cleaning Process</h2>
                <p>
                    The property, surfaces, condition, accessibility, and
                    requested cleaning areas help determine the project plan.
                </p>
            </div>

            <div class="service-process-grid">

                <div class="service-process-step">
                    <span>01</span>
                    <h3>Discuss the Property</h3>
                    <p>
                        Identify the parking areas and particular concerns
                        you would like addressed.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>02</span>
                    <h3>Evaluate the Surfaces</h3>
                    <p>
                        Consider material, condition, accessibility, and
                        applicable site requirements.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>03</span>
                    <h3>Perform the Cleaning</h3>
                    <p>
                        Address agreed-upon surfaces using methods appropriate
                        for the material and buildup.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>04</span>
                    <h3>Review the Results</h3>
                    <p>
                        Review cleaned areas and identify remaining permanent
                        staining or surface concerns where applicable.
                    </p>
                </div>

            </div>
        </section>


        <ServiceFAQ faqs={faqs} />

    </div>

</ServiceLayout>