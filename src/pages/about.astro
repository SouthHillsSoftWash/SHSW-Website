---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About Us | South Hills Soft Wash">

    <!-- ============================================
         ABOUT HERO
    ============================================= -->
    <section class="about-hero">
        <div class="about-container about-hero-content">

            <div class="about-hero-copy">
                <p class="section-eyebrow">About South Hills Soft Wash</p>

                <h1>
                    Built With Hard Work.<br />
                    <span>Run With Heart.</span>
                </h1>

                <p class="about-hero-description">
                    South Hills Soft Wash is a family-run exterior cleaning
                    company founded in 2022. Brian personally handles the work
                    in the field, while his wife helps keep everything moving
                    behind the scenes.
                </p>
            </div>

            <!--
                FROG ZONE #1
                Great place for a frog head / peeking frog later.

                When your artwork is ready, something like:

                <img
                    src="/images/frog/frog-peeking.png"
                    alt=""
                    class="about-hero-frog"
                    aria-hidden="true"
                />
            -->

        </div>

        <svg
            class="about-hero-wave"
            viewBox="0 0 1440 100"
            preserveAspectRatio="none"
            aria-hidden="true"
        >
            <path
                d="M0,35 C240,90 480,0 720,42 S1200,90 1440,30 L1440,100 L0,100 Z"
            />
        </svg>
    </section>


    <!-- ============================================
         WHO WE ARE
    ============================================= -->
    <section class="about-story">
        <div class="about-container about-story-grid">

            <div class="about-story-image">

                <!--
                    Replace this path with whichever real Brian photo
                    you want to use on the About page.
                -->
                <img
                    src="/images/hero-home.png"
                    alt="Brian of South Hills Soft Wash"
                />

                <div class="about-story-year">
                    <strong>2022</strong>
                    <span>Where SHSW began</span>
                </div>

            </div>

            <div class="about-story-copy">
                <p class="section-eyebrow">Who We Are</p>

                <h2>
                    From Welding to<br />
                    South Hills Soft Wash.
                </h2>

                <p>
                    Before starting South Hills Soft Wash in 2022, Brian worked
                    as a welder. His background was rooted in hands-on work,
                    attention to detail, and taking pride in the finished
                    result.
                </p>

                <p>
                    Today, he brings that same hands-on mindset to his own
                    business. Brian personally handles the exterior cleaning
                    work and genuinely cares about the properties entrusted
                    to him.
                </p>

                <p>
                    South Hills Soft Wash is small and personal by design.
                    The person behind the business is also the person showing
                    up to do the work.
                </p>
            </div>

        </div>
    </section>


    <!-- ============================================
         FAMILY RUN
    ============================================= -->
    <section class="about-family">
        <div class="about-container about-family-grid">

            <div class="about-family-copy">
                <p class="section-eyebrow">Family Run</p>

                <h2>
                    There’s Family Behind<br />
                    the Scenes, Too.
                </h2>

                <p>
                    While Brian handles the work in the field, his wife helps
                    keep South Hills Soft Wash running behind the scenes,
                    supporting the administrative and day-to-day side of the
                    business.
                </p>

                <p>
                    It’s a small family operation with real people behind every
                    job, every message, and everything that goes into keeping
                    the business moving.
                </p>
            </div>

            <div class="about-family-visual">

                <div class="about-family-card">
                    <span class="about-family-number">01</span>
                    <h3>In the Field</h3>
                    <p>
                        Brian personally handles the exterior cleaning work.
                    </p>
                </div>

                <div class="about-family-card">
                    <span class="about-family-number">02</span>
                    <h3>Behind the Scenes</h3>
                    <p>
                        His wife, Sammi, helps manage the administrative side of the
                        family business.
                    </p>
                </div>

                <!--
                    FROG ZONE #2

                    A small full-body frog could sit/lean around these
                    cards once you have the artwork.

                    <img
                        src="/images/frog/frog-sitting.png"
                        alt=""
                        class="about-family-frog"
                        aria-hidden="true"
                    />
                -->

            </div>

        </div>
    </section>


    <!-- ============================================
         OUR APPROACH
    ============================================= -->
    <section class="about-approach">
        <div class="about-container">

            <div class="about-section-heading">
                <p class="section-eyebrow">Our Approach</p>

                <h2>
                    Your Property Isn’t<br />
                    Just Another Job.
                </h2>

                <p>
                    South Hills Soft Wash is built around hands-on work and
                    genuine care for the finished result.
                </p>
            </div>

            <div class="about-values-grid">

                <article class="about-value-card">
                    <span class="about-value-number">01</span>

                    <h3>Hands-On</h3>

                    <p>
                        The owner of the business is also the person doing the
                        work on your property.
                    </p>
                </article>

                <article class="about-value-card">
                    <span class="about-value-number">02</span>

                    <h3>Thoughtful</h3>

                    <p>
                        Different surfaces and different conditions can call
                        for different approaches to exterior cleaning.
                    </p>
                </article>

                <article class="about-value-card">
                    <span class="about-value-number">03</span>

                    <h3>Family-Run</h3>

                    <p>
                        From the work in the field to what happens behind the
                        scenes, South Hills Soft Wash is operated by family.
                    </p>
                </article>

            </div>

        </div>
    </section>

    <!-- ============================================
         BRAND STATEMENT
    ============================================= -->

    <section class="about-brand-statement">

        <!-- Top wave -->
        <svg
            class="about-brand-wave about-brand-wave-top"
            viewBox="0 0 1440 100"
            preserveAspectRatio="none"
            aria-hidden="true"
        >
            <path
                d="M0,45 C220,5 430,90 700,42 C970,-5 1190,85 1440,30 L1440,100 L0,100 Z"
            />
        </svg>

        <div class="about-container about-brand-statement-content">
            <p>Little Pressure.</p>
            <h2>Big Clean.</h2>
        </div>

    </section>


    <!-- ============================================
         MEET THE FROG
    ============================================= -->
    <section class="about-frog">

        <svg
            class="about-frog-wave"
            viewBox="0 0 1440 100"
            preserveAspectRatio="none"
            aria-hidden="true"
        >
            <path
                d="M0,35 C240,90 480,0 720,42 S1200,90 1440,30 L1440,100 L0,100 Z"
            />
        </svg>
        
        <div class="about-container about-frog-grid">

            <div class="about-frog-art">
                <img
                    src="/images/scrubby/thumbs-up.png"
                    alt="Scrubby, the South Hills Soft Wash red-eyed tree frog mascot"
                    class="about-frog-image"
                />
            </div>

            <div class="about-frog-copy">
                <p class="section-eyebrow">Meet the Frog</p>

                <h2>
                    <span>Scrubby, Our Little Green</span><br />
                    Trademark.
                </h2>

                <p>
                    If you’ve spent any time around South Hills Soft Wash,
                    you’ve probably noticed a certain red-eyed tree frog
                    making frequent appearances. This is Scrubby!
                </p>

                <p>
                    Scrubby is an officially trademarked part of the
                    South Hills Soft Wash brand. Designed within the family,
                    he brings a little personality to SHSW and has become
                    an unmistakable part of how the business looks and feels.
                </p>

                <div class="about-frog-fact">
                    <span class="about-frog-fact-label">Species</span>
                    <strong>Red-Eyed Tree Frog</strong>
                </div>

                <!--
                    Once your sister confirms his official name,
                    we can add another:

                    <div class="about-frog-fact">
                        <span class="about-frog-fact-label">Name</span>
                        <strong>FROG GOVERNMENT NAME</strong>
                    </div>
                -->

            </div>

        </div>
    </section>


    <!-- ============================================
         SOCIAL
    ============================================= -->
    <section class="about-social">
        <div class="about-container about-social-grid">

            <div class="about-social-copy">
                <p class="section-eyebrow">Follow Our Work</p>

                <h2>
                    See What We’re<br />
                    <span>Up To.</span>
                </h2>

                <p>
                    Follow South Hills Soft Wash on social media to see
                    recent work, exterior transformations, and more from
                    behind the scenes.
                </p>
            </div>

            <div class="about-social-links">

                <a
                    href="https://www.facebook.com/southhillssoftwash/"
                    target="_blank"
                    rel="noopener"
                    class="about-social-card"
                    aria-label="South Hills Soft Wash on Facebook"
                >
                    <div>
                        <span class="about-social-label">Follow us on</span>
                        <strong>Facebook</strong>
                    </div>

                    <span class="about-social-arrow" aria-hidden="true">→</span>
                </a>

                <a
                    href="https://www.tiktok.com/@southhillssoftwash"
                    target="_blank"
                    rel="noopener"
                    class="about-social-card"
                    aria-label="South Hills Soft Wash on TikTok"
                >
                    <div>
                        <span class="about-social-label">Follow us on</span>
                        <strong>TikTok</strong>
                    </div>

                    <span class="about-social-arrow" aria-hidden="true">→</span>
                </a>

                <!--
                    FROG ZONE #4

                    This would be AMAZING for a frog holding a phone,
                    taking a picture, pointing, etc.

                    <img
                        src="/images/frog/frog-social.png"
                        alt=""
                        class="about-social-frog"
                        aria-hidden="true"
                    />
                -->

            </div>

        </div>
    </section>


    <!-- ============================================
         FINAL CTA
    ============================================= -->
    <section class="about-cta">

        <svg
            class="about-cta-wave"
            viewBox="0 0 1440 100"
            preserveAspectRatio="none"
            aria-hidden="true"
        >
            <defs>
                <linearGradient
                    id="about-cta-gradient"
                    x1="0%"
                    y1="0%"
                    x2="100%"
                    y2="0%"
                >
                    <stop offset="0%" stop-color="#429D8E" />
                    <stop offset="100%" stop-color="#73BF68" />
                </linearGradient>
            </defs>

            <path
                d="M0,35 C240,90 480,0 720,42 S1200,90 1440,30 L1440,100 L0,100 Z"
                fill="url(#about-cta-gradient)"
            />
        </svg>

        <div class="about-container about-cta-content">

            <p class="section-eyebrow">Let’s Get Started</p>

            <h2>
                Make Your Property<br />
                Look New Again.
            </h2>

            <p>
                Tell us about your property and what you’d like cleaned.
            </p>

            <a href="/contact/" class="about-cta-button">
                Request a Free Quote
                <span aria-hidden="true">→</span>
            </a>

            <!--
                FROG ZONE #5

                Your leaning/lounging frog would be PERFECT here.
                Eventually:

                <img
                    src="/images/frog/frog-leaning.png"
                    alt=""
                    class="about-cta-frog"
                    aria-hidden="true"
                />
            -->

        </div>

    </section>

</BaseLayout>