---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Areas Served"
    description="South Hills Soft Wash provides residential and commercial exterior cleaning throughout the South Hills and surrounding Pennsylvania communities near Monongahela."
>
    <!-- ============================================
         HERO
    ============================================= -->
    <section class="areas-hero">
        <div class="areas-page-container areas-hero-content">
            <p class="section-eyebrow">Areas Served</p>

            <h1>
                Proudly Serving the<br />
                <span>South Hills & Beyond.</span>
            </h1>

            <p class="areas-hero-description">
                South Hills Soft Wash serves residential and commercial
                properties throughout the South Hills and surrounding
                communities, generally within about an hour of the Monongahela
                area.
            </p>
        </div>

        <svg
            class="areas-hero-wave"
            viewBox="0 0 1440 100"
            preserveAspectRatio="none"
            aria-hidden="true"
        >
            <path
                d="M0,35 C240,90 480,0 720,42 S1200,90 1440,30 L1440,100 L0,100 Z"
            ></path>
        </svg>
    </section>

    <!-- ============================================
         SERVICE AREA INTRO
    ============================================= -->
    <section class="areas-intro">
        <div class="areas-page-container areas-intro-grid">
            <div class="areas-intro-heading">
                <p class="section-eyebrow">Our Service Area</p>

                <h2>
                    Local Service With a<br />
                    <span>Wide Reach.</span>
                </h2>
            </div>

            <div class="areas-intro-copy">
                <p>
                    Based in the Monongahela area, South Hills Soft Wash
                    generally serves properties located within about an hour of
                    home base, with much of our work taking place throughout
                    Pittsburgh’s South Hills.
                </p>

                <p>
                    Our service area extends across surrounding Pennsylvania
                    communities, but does not extend into West Virginia.
                    Availability can vary depending on location, travel time,
                    and the project itself.
                </p>

                <p>
                    The locations shown below represent communities within our
                    general service area and are not an exhaustive list.
                </p>
            </div>
        </div>
    </section>

    <!-- ============================================
         MAP
    ============================================= -->
    <section class="areas-map-section">
        <div class="areas-page-container">
            <div class="areas-section-heading">
                <p class="section-eyebrow">Explore Our Area</p>

                <h2>Where We Work</h2>

                <p>
                    Explore some of the communities around our general service
                    area. Don’t see your town? That doesn’t necessarily mean
                    you’re outside our range.
                </p>
            </div>

            <div class="areas-map-shell">
                <div
                    id="areas-map"
                    class="areas-map"
                    aria-label="Map showing communities served by South Hills Soft Wash"
                >
                </div>

                <div class="areas-map-note">
                    <span class="areas-map-note-icon" aria-hidden="true">●</span
                    >

                    <p>
                        Map locations are representative. Service availability
                        is based on travel time and project location rather than
                        a strict geographic boundary.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================
         FEATURED COMMUNITIES
    ============================================= -->
    <section class="areas-communities">
        <div class="areas-page-container">
            <div class="areas-section-heading">
                <p class="section-eyebrow">Communities We Serve</p>

                <h2>
                    Around the South Hills<br />
                    & Surrounding Areas.
                </h2>

                <p>
                    These are some of the communities within our general service
                    area. This list is not exhaustive.
                </p>
            </div>

            <div class="areas-community-grid">
                <div class="areas-community-card">
                    <span class="areas-community-number">01</span>
                    <h3>South Hills</h3>

                    <ul>
                        <li>Mt. Lebanon</li>
                        <li>Bethel Park</li>
                        <li>Upper St. Clair</li>
                        <li>Baldwin</li>
                        <li>Whitehall</li>
                        <li>Brentwood</li>
                    </ul>
                </div>

                <div class="areas-community-card">
                    <span class="areas-community-number">02</span>
                    <h3>Mon Valley</h3>

                    <ul>
                        <li>Monongahela</li>
                        <li>West Mifflin</li>
                        <li>Jefferson Hills</li>
                        <li>Pleasant Hills</li>
                        <li>Elizabeth</li>
                        <li>Clairton</li>
                    </ul>
                </div>

                <div class="areas-community-card">
                    <span class="areas-community-number">03</span>
                    <h3>Surrounding Communities</h3>

                    <ul>
                        <li>Irwin</li>
                        <li>North Huntingdon</li>
                        <li>Monroeville</li>
                        <li>McKeesport</li>
                        <li>Finleyville</li>
                        <li>Canonsburg</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================
         LITTLE PRESSURE, BIG CLEAN
    ============================================= -->
    <section class="areas-brand-statement">
        <svg
            class="areas-brand-wave areas-brand-wave-top"
            viewBox="0 0 1440 100"
            preserveAspectRatio="none"
            aria-hidden="true"
        >
            <path
                d="M0,45 C220,5 430,90 700,42 C970,-5 1190,85 1440,30 L1440,100 L0,100 Z"
            ></path>
        </svg>

        <div class="areas-page-container areas-brand-content">
            <p>Little Pressure.</p>
            <h2>Big Clean.</h2>

            <div class="areas-brand-scrubby" aria-hidden="true">
                <img src="/images/scrubby/text-lean.png" alt="" />
            </div>
        </div>

        <svg
            class="areas-brand-wave areas-brand-wave-bottom"
            viewBox="0 0 1440 100"
            preserveAspectRatio="none"
            aria-hidden="true"
        >
            <path d="M0,35 C240,90 480,0 720,42 S1200,90 1440,30 L1440,0 L0,0 Z"
            ></path>
        </svg>
    </section>

    <!-- ============================================
         DON'T SEE YOUR AREA
    ============================================= -->
    <section class="areas-check">
        <div class="areas-page-container areas-check-grid">
            <div class="areas-check-heading">
                <p class="section-eyebrow">Don’t See Your Area?</p>

                <h2>Just Ask.</h2>
            </div>

            <div class="areas-check-copy">
                <p>
                    Our service area isn’t limited to the communities listed
                    above. If your property is roughly within an hour of the
                    Monongahela area, reach out and let us know where you’re
                    located.
                </p>

                <p>
                    We’ll let you know whether your property falls within our
                    current service area.
                </p>

                <a href="/contact/" class="areas-check-link">
                    Check Your Location
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>
    </section>

    <!-- ============================================
         FINAL CTA
    ============================================= -->
    <section class="areas-cta">
        <svg
            class="areas-cta-wave"
            viewBox="0 0 1440 100"
            preserveAspectRatio="none"
            aria-hidden="true"
        >
            <defs>
                <linearGradient
                    id="areas-cta-gradient"
                    x1="0%"
                    y1="0%"
                    x2="100%"
                    y2="0%"
                >
                    <stop offset="0%" stop-color="#429D8E"></stop>
                    <stop offset="100%" stop-color="#73BF68"></stop>
                </linearGradient>
            </defs>

            <path
                d="M0,35 C240,90 480,0 720,42 S1200,90 1440,30 L1440,100 L0,100 Z"
                fill="url(#areas-cta-gradient)"></path>
        </svg>

        <div class="areas-page-container areas-cta-content">
            <p class="section-eyebrow">Ready to Get Started?</p>

            <h2>Make Your Property Look New Again.</h2>

            <p>Tell us where you’re located and what you’d like cleaned.</p>

            <a href="/contact/" class="areas-cta-button">
                Request a Free Quote
                <span aria-hidden="true">→</span>
            </a>
        </div>
    </section>

    <!-- ============================================
         LEAFLET
    ============================================= -->

    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    />

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" is:inline
    ></script>

    <script is:inline>
        document.addEventListener("DOMContentLoaded", () => {
            const mapElement = document.getElementById("areas-map");

            if (!mapElement || typeof L === "undefined") {
                return;
            }

            const map = L.map("areas-map", {
                scrollWheelZoom: false,
            }).setView([40.25, -79.95], 9);

            L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                maxZoom: 19,
                attribution:
                    '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
            }).addTo(map);

            const locations = [
                {
                    name: "Monongahela",
                    coordinates: [40.2031, -79.9262],
                },
                {
                    name: "Mt. Lebanon",
                    coordinates: [40.3553, -80.0495],
                },
                {
                    name: "Bethel Park",
                    coordinates: [40.3276, -80.0395],
                },
                {
                    name: "West Mifflin",
                    coordinates: [40.3634, -79.8664],
                },
                {
                    name: "Jefferson Hills",
                    coordinates: [40.2912, -79.9314],
                },
                {
                    name: "Pleasant Hills",
                    coordinates: [40.3356, -79.9606],
                },
                {
                    name: "Irwin",
                    coordinates: [40.3245, -79.7012],
                },
                {
                    name: "North Huntingdon",
                    coordinates: [40.3373, -79.7298],
                },
                {
                    name: "Monroeville",
                    coordinates: [40.4212, -79.7881],
                },
                {
                    name: "Canonsburg",
                    coordinates: [40.2626, -80.1873],
                },
            ];

            const markerIcon = L.divIcon({
                className: "areas-map-marker-wrapper",
                html: `
                    <div class="areas-map-marker">
                        <div class="areas-map-marker-center"></div>
                    </div>
                `,
                iconSize: [26, 34],
                iconAnchor: [13, 34],
                popupAnchor: [0, -30],
            });

            locations.forEach((location) => {
                L.marker(location.coordinates, {
                    icon: markerIcon,
                })
                    .addTo(map)
                    .bindPopup(`<strong>${location.name}, PA</strong>`);
            });
        });
    </script>
</BaseLayout>
