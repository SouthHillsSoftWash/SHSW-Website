---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Contact Us"
    description="Request a free quote from South Hills Soft Wash for residential or commercial exterior cleaning services."
>
    <!-- =========================================
         CONTACT HERO
    ========================================== -->
    <section class="contact-hero">
        <div class="contact-page-container contact-hero-content">
            <p class="section-eyebrow">Contact Us</p>

            <h1>
                Ready to Make Your<br />
                <span>Property Look New Again?</span>
            </h1>

            <p class="contact-hero-description">
                Tell us a little about your property and the work you're
                interested in. Submit the form below to request a free quote
                from South Hills Soft Wash.
            </p>
        </div>

        <svg
            class="contact-hero-wave"
            viewBox="0 0 1440 100"
            preserveAspectRatio="none"
            aria-hidden="true"
        >
            <path
                d="M0,45 C220,5 430,90 700,42 C970,-5 1190,85 1440,30 L1440,100 L0,100 Z"
            ></path>
        </svg>
    </section>

    <!-- =========================================
         QUOTE FORM
    ========================================== -->
    <section class="contact-form-section">
        <div class="contact-page-container">
            <div class="contact-section-heading">
                <p class="section-eyebrow">Request a Free Quote</p>

                <h2>Tell Us About Your Project.</h2>

                <p>
                    Fill out the form below with a few details about your
                    property and the services you're interested in.
                </p>
            </div>

            <div class="contact-form-shell">
                <script
                    is:inline
                    type="text/javascript"
                    src="https://form.jotform.com/jsform/262714004417146"
                ></script>
            </div>
        </div>
    </section>

    <!-- =========================================
         DIRECT CONTACT
    ========================================== -->
    <section class="contact-direct">
        <div class="contact-page-container contact-direct-grid">
            <div class="contact-direct-heading">
                <p class="section-eyebrow">Have a Question?</p>

                <h2>
                    Prefer to Reach<br />
                    <span>Out Directly?</span>
                </h2>
            </div>

            <div class="contact-direct-copy">
                <p>
                    Have a question before requesting a quote? South Hills Soft
                    Wash is happy to help. You can also reach out directly by
                    phone, email, or through social media.
                </p>

                <div class="contact-direct-links">
                    <a
                        href="tel:+14126542449"
                        class="contact-direct-link contact-direct-link-info"
                    >
                        <span class="contact-direct-link-label">Phone</span>

                        <span class="contact-direct-value"> 412-654-2449 </span>

                        <span class="contact-direct-link-action">
                            Give Us a Call
                            <span aria-hidden="true">→</span>
                        </span>
                    </a>

                    <a
                        href="mailto:southhillssoftwash@gmail.com"
                        class="contact-direct-link contact-direct-link-info"
                    >
                        <span class="contact-direct-link-label">Email</span>

                        <span class="contact-direct-value contact-direct-email">
                            southhillssoftwash@gmail.com
                        </span>

                        <span class="contact-direct-link-action">
                            Send Us an Email
                            <span aria-hidden="true">→</span>
                        </span>
                    </a>

                    <a
                        href="https://www.facebook.com/southhillssoftwash/"
                        class="contact-direct-link contact-direct-link-social"
                        target="_blank"
                        rel="noopener"
                    >
                        <span class="contact-direct-link-label">Facebook</span>

                        <span class="contact-direct-link-action">
                            Find Us on Facebook
                            <span aria-hidden="true">→</span>
                        </span>
                    </a>

                    <a
                        href="https://www.tiktok.com/@southhillssoftwash"
                        class="contact-direct-link contact-direct-link-social"
                        target="_blank"
                        rel="noopener"
                    >
                        <span class="contact-direct-link-label">TikTok</span>

                        <span class="contact-direct-link-action">
                            Find Us on TikTok
                            <span aria-hidden="true">→</span>
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- =========================================
         BRAND STATEMENT
    ========================================== -->
    <section class="contact-brand-statement">
        <svg
            class="contact-brand-wave contact-brand-wave-top"
            viewBox="0 0 1440 100"
            preserveAspectRatio="none"
            aria-hidden="true"
        >
            <path
                d="M0,45 C220,5 430,90 700,42 C970,-5 1190,85 1440,30 L1440,100 L0,100 Z"
            ></path>
        </svg>

        <div class="contact-page-container contact-brand-content">
            <p>Little Pressure.</p>
            <h2>Big Clean.</h2>
        </div>
    </section>
</BaseLayout>
