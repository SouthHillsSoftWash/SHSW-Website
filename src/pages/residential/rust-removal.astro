
---
import ServiceLayout from "../../layouts/ServiceLayout.astro";
import ServiceFAQ from "../../components/ServiceFAQ.astro";

const faqs = [
    {
        question: "What causes rust stains on exterior surfaces?",
        answer: "Rust staining commonly develops when iron-containing materials or water come into contact with exterior surfaces. Sources may include metal furniture, irrigation water, fertilizer, tools, railings, and other metal objects exposed to moisture."
    },
    {
        question: "Can rust stains be removed from concrete?",
        answer: "Many rust stains on concrete can be addressed with specialized cleaning treatments. Results depend on the age and severity of the stain, the condition of the concrete, and how deeply the discoloration has penetrated."
    },
    {
        question: "Can rust be removed from pavers and brick?",
        answer: "Certain rust stains on pavers and brick may be treatable, but the appropriate cleaning product and method depend on the material, finish, and condition. Some surfaces are sensitive to particular cleaning chemicals."
    },
    {
        question: "Is rust removal the same as pressure washing?",
        answer: "No. Rust staining often requires a targeted chemical treatment rather than water pressure alone. Increasing pressure does not necessarily remove the discoloration and can damage some exterior surfaces."
    },
    {
        question: "Can irrigation systems cause rust stains?",
        answer: "Yes. Water containing dissolved iron can leave orange or brown deposits on surfaces exposed to repeated sprinkler runoff. If the underlying water source continues to deposit iron, staining may return after cleaning."
    },
    {
        question: "Can fertilizer cause rust-colored stains?",
        answer: "Some fertilizers contain iron, which can leave rust-colored staining when granules or residue contact wet concrete and other exterior surfaces. The appropriate treatment depends on the surface and the nature of the stain."
    },
    {
        question: "Will rust removal fix corroded metal?",
        answer: "No. Removing rust-colored stains from surrounding surfaces is different from repairing corrosion on metal itself. Severely corroded components, damaged coatings, and structural deterioration may require separate repair or replacement."
    },
    {
        question: "Can every rust stain be completely removed?",
        answer: "Complete removal cannot be guaranteed. Results depend on the source, age, depth, and severity of the staining, along with the material being treated. Some discoloration may remain after cleaning."
    },
    {
        question: "Will rust stains come back?",
        answer: "Rust staining may return if the original source remains. For example, ongoing irrigation runoff containing iron or repeated contact with corroding metal can create new deposits after the surface has been cleaned."
    },
    {
        question: "How can I request a rust removal quote?",
        answer: "Contact South Hills Soft Wash with information about the stained surface, approximate affected area, and suspected source of the rust. Photos can help communicate the type and extent of staining."
    }
];
---

<ServiceLayout
    title="Rust Removal"
    description="Address stubborn rust-colored staining on suitable exterior surfaces with targeted cleaning treatments selected for the material and type of discoloration."
    image="/images/residential/rust_cleaning.jpg"
>

    <p class="section-eyebrow">Specialized Stain Treatment</p>

    <h2>Target the Stain, Not Just the Surface</h2>

    <p>
        Orange and brown rust stains can stand out against
        concrete, pavers, masonry, and other exterior surfaces.
        Unlike ordinary dirt or organic buildup, these stains
        often require a specialized cleaning approach.
    </p>

    <p>
        Rust-colored discoloration may come from metal objects,
        irrigation water, fertilizer, or other iron-containing
        sources. Identifying the likely cause and evaluating
        the affected material helps determine an appropriate
        treatment.
    </p>


    <div slot="extra">

        <!-- COMMON SURFACES -->

        <section class="service-info-section">
            <div class="service-info-heading">
                <p class="section-eyebrow">Affected Surfaces</p>
                <h2>Where Do Rust Stains Appear?</h2>
                <p>
                    Rust-colored staining can develop across
                    a variety of exterior materials. Each
                    surface requires consideration before
                    a specialized treatment is applied.
                </p>
            </div>

            <div class="service-info-grid">

                <div class="service-info-card">
                    <span>01</span>
                    <h3>Concrete Driveways</h3>
                    <p>
                        Concrete can develop rust-colored
                        stains from metal objects, irrigation
                        water, fertilizer, and automotive
                        components. Its porosity can allow
                        discoloration to penetrate the surface.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>02</span>
                    <h3>Sidewalks & Walkways</h3>
                    <p>
                        Exterior walking surfaces can collect
                        rust deposits from nearby landscaping,
                        metal fixtures, and repeated exposure
                        to iron-containing water.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>03</span>
                    <h3>Pavers & Masonry</h3>
                    <p>
                        Brick, pavers, and certain masonry
                        surfaces may develop rust-colored
                        staining. Treatment should account
                        for the material, finish, and
                        any existing sealer.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>04</span>
                    <h3>Patios & Exterior Features</h3>
                    <p>
                        Patios and compatible exterior
                        surfaces can be affected by rust
                        deposits from furniture, planters,
                        railings, and decorative metal items.
                    </p>
                </div>

            </div>
        </section>


        <!-- SOURCES OF RUST -->

        <section class="service-info-section service-info-split">

            <div>
                <p class="section-eyebrow">Common Causes</p>
                <h2>Where Do Rust Stains Come From?</h2>
            </div>

            <div class="service-info-copy">
                <p>
                    Rust-colored stains often develop when
                    iron-containing materials or deposits
                    are exposed to moisture. Understanding
                    the source can help determine the
                    appropriate cleaning treatment.
                </p>

                <ul class="service-check-list">
                    <li>Metal patio furniture and decorative items</li>
                    <li>Iron-containing irrigation or well water</li>
                    <li>Fertilizer containing iron</li>
                    <li>Metal tools and equipment left outdoors</li>
                    <li>Railings, fasteners, and other metal fixtures</li>
                    <li>Runoff from corroding metal components</li>
                    <li>Repeated sprinkler exposure on exterior surfaces</li>
                </ul>

                <p>
                    If the source of the staining remains,
                    new rust deposits may develop after
                    the surface has been cleaned.
                </p>
            </div>

        </section>


        <!-- SPECIALIZED TREATMENT -->

        <section class="service-info-section service-method-section">

            <div class="service-info-heading">
                <p class="section-eyebrow">The Cleaning Approach</p>
                <h2>Why Rust Requires Specialized Treatment</h2>
            </div>

            <div class="service-method-content">
                <p>
                    Rust staining is different from the
                    organic buildup commonly addressed
                    during routine exterior washing.
                    Water pressure alone may not remove
                    iron-related discoloration.
                </p>

                <p>
                    Specialized rust-removal products work
                    through chemical reactions that help
                    address iron-containing deposits.
                    The appropriate product and application
                    method depend on the surface material,
                    its condition, and the type of staining.
                </p>

                <p>
                    Some exterior materials, coatings,
                    and sealers can be sensitive to
                    certain cleaning chemicals. Proper
                    product selection and surface
                    evaluation are important parts
                    of the treatment process.
                </p>

                <p>
                    Deeply embedded staining, deteriorated
                    finishes, and certain forms of permanent
                    discoloration may not be completely
                    reversible through cleaning.
                </p>
            </div>

        </section>


        <!-- RUST VS OTHER STAINS -->

        <section class="service-info-section">

            <div class="service-info-heading">
                <p class="section-eyebrow">Understanding the Difference</p>
                <h2>Not Every Exterior Stain Is the Same</h2>
                <p>
                    Identifying the type of discoloration
                    helps determine whether routine
                    cleaning or a more targeted
                    treatment may be appropriate.
                </p>
            </div>

            <div class="service-info-grid">

                <div class="service-info-card">
                    <span>01</span>
                    <h3>Rust Staining</h3>
                    <p>
                        Orange or brown discoloration
                        associated with iron-containing
                        deposits and corrosion-related runoff.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>02</span>
                    <h3>Organic Buildup</h3>
                    <p>
                        Algae, moss, and other organic
                        growth often require a different
                        cleaning approach from rust stains.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>03</span>
                    <h3>Oil & Automotive Stains</h3>
                    <p>
                        Petroleum-based staining may
                        penetrate porous surfaces and
                        require treatments designed
                        for that type of residue.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>04</span>
                    <h3>Mineral Deposits</h3>
                    <p>
                        Hard-water deposits and other
                        mineral-related discoloration
                        may resemble certain stains
                        but require different treatment.
                    </p>
                </div>

            </div>
        </section>


        <!-- EXPECTATIONS -->

        <section class="service-info-section service-info-split">

            <div>
                <p class="section-eyebrow">What to Know</p>
                <h2>Understanding Rust Removal Results</h2>
            </div>

            <div class="service-info-copy">
                <p>
                    Rust removal can make a noticeable
                    difference to affected exterior
                    surfaces, but results depend on
                    several factors.
                </p>

                <ul class="service-check-list">
                    <li>The source of the staining</li>
                    <li>How long the stain has been present</li>
                    <li>The severity and depth of discoloration</li>
                    <li>The material and condition of the surface</li>
                    <li>Existing coatings or sealers</li>
                    <li>Whether the original staining source remains</li>
                </ul>

                <p>
                    Cleaning addresses the stain itself,
                    but it does not repair corroded metal,
                    restore damaged finishes, or prevent
                    new staining from an ongoing source.
                </p>
            </div>

        </section>


        <!-- PROCESS -->

        <section class="service-info-section">

            <div class="service-info-heading">
                <p class="section-eyebrow">What to Expect</p>
                <h2>Our Rust Removal Process</h2>
                <p>
                    Specialized stain treatment begins
                    with understanding the affected
                    surface and the likely source
                    of the discoloration.
                </p>
            </div>

            <div class="service-process-grid">

                <div class="service-process-step">
                    <span>01</span>
                    <h3>Discuss the Staining</h3>
                    <p>
                        Tell us where the stain is located,
                        how long it has been present,
                        and what may have caused it.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>02</span>
                    <h3>Evaluate the Surface</h3>
                    <p>
                        Consider the material, finish,
                        condition, and type of staining
                        before selecting a treatment.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>03</span>
                    <h3>Targeted Treatment</h3>
                    <p>
                        Address the agreed-upon staining
                        using a cleaning approach
                        appropriate for the surface.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>04</span>
                    <h3>Review the Results</h3>
                    <p>
                        Review the treated area and
                        discuss any remaining discoloration
                        or ongoing sources of staining.
                    </p>
                </div>

            </div>

        </section>


        <!-- FAQ -->

        <ServiceFAQ faqs={faqs} />

    </div>

</ServiceLayout>
