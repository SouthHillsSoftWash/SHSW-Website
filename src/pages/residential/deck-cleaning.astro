---
import ServiceLayout from "../../layouts/ServiceLayout.astro";
import ServiceFAQ from "../../components/ServiceFAQ.astro";

const faqs = [
    {
        question: "What types of decks can be cleaned?",
        answer: "Common decking materials include pressure-treated wood, cedar, composite, PVC, and other manufactured decking products. Each material has different cleaning requirements, so the appropriate approach depends on the surface, its condition, and manufacturer recommendations.",
    },
    {
        question: "Can deck cleaning remove green algae?",
        answer: "Deck cleaning can address many types of algae-related discoloration and organic buildup. Results depend on the decking material, the extent of the growth, and the condition of the surface.",
    },
    {
        question: "Is pressure washing safe for wooden decks?",
        answer: "Wood requires careful cleaning because excessive pressure can raise the grain, cause splintering, and damage weathered boards. Cleaning methods should be selected according to the wood species, condition, and existing finish.",
    },
    {
        question: "Can cleaning restore weathered wood to its original color?",
        answer: "Cleaning can remove applicable surface buildup and improve the appearance of wood, but natural aging, UV exposure, and permanent discoloration may remain. Sanding, staining, and refinishing are separate services.",
    },
    {
        question: "Can composite decking be cleaned?",
        answer: "Many composite decking products can be cleaned, but cleaning requirements vary by manufacturer and product. Certain chemicals, excessive pressure, or abrasive methods may affect the surface or finish.",
    },
    {
        question: "Will deck cleaning remove old paint or stain?",
        answer: "Routine deck cleaning is not the same as paint stripping or stain removal. Existing coatings may be affected by cleaning, particularly when they are already deteriorating. Any stripping or refinishing work should be discussed separately.",
    },
    {
        question: "Can you clean deck railings and stairs?",
        answer: "Railings, stairs, posts, and other deck features can have different materials and cleaning requirements. Mention the areas you would like addressed when requesting your quote so the scope of work can be discussed.",
    },
    {
        question: "How often should I have my deck cleaned?",
        answer: "Cleaning frequency depends on the material, shade, surrounding vegetation, moisture, foot traffic, and visible buildup. Decks beneath trees or in damp areas may need more frequent attention.",
    },
    {
        question: "Do I need to prepare my deck before cleaning?",
        answer: "It is helpful to discuss outdoor furniture, planters, decorations, grills, and access requirements before the appointment. South Hills Soft Wash can provide preparation instructions appropriate for your property.",
    },
    {
        question: "How do I request a deck cleaning quote?",
        answer: "Contact South Hills Soft Wash with your deck's approximate size, material, and any specific areas of concern. Photos can help communicate the condition of the surface and the cleaning needed.",
    },
];
---

<ServiceLayout
    title="Deck Cleaning"
    seoTitle="Deck Cleaning"
    description="Refresh your outdoor living space by addressing dirt, organic buildup, and exterior discoloration with cleaning methods suited to your decking material."
    image="/images/residential/deck_cleaning.jpg"
    seoDescription="Professional deck cleaning from South Hills Soft Wash for homes throughout the South Hills and surrounding Pittsburgh communities."
>
    <p class="section-eyebrow">Decks & Outdoor Living</p>

    <h2>Bring New Life to Your Outdoor Space</h2>

    <p>
        Your deck is an extension of your home—a place to relax, entertain, and
        enjoy time outdoors. With regular exposure to sunlight, rain, moisture,
        and surrounding vegetation, decking surfaces can develop dirt,
        discoloration, and organic buildup.
    </p>

    <p>
        Professional deck cleaning helps refresh the appearance of your outdoor
        space while considering the material, existing finish, and condition of
        the surface. Wood, composite, and PVC decking each require an
        appropriate cleaning approach.
    </p>

    <div slot="extra">
        <!-- ============================================
         MATERIALS
        ============================================= -->

        <section class="service-info-section">
            <div class="service-info-heading">
                <p class="section-eyebrow">Decking Materials</p>
                <h2>Cleaning for Different Deck Types</h2>
                <p>
                    Decking materials vary in durability, texture, finish, and
                    maintenance requirements. Choosing the right cleaning method
                    begins with understanding the surface.
                </p>
            </div>

            <div class="service-info-grid">
                <div class="service-info-card">
                    <span>01</span>
                    <h3>Pressure-Treated Wood</h3>
                    <p>
                        Pressure-treated decking can accumulate dirt, algae, and
                        weather-related discoloration. Cleaning should account
                        for the wood's condition and any existing stain or
                        sealer.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>02</span>
                    <h3>Cedar & Natural Wood</h3>
                    <p>
                        Natural wood decking can develop organic buildup and
                        discoloration from prolonged outdoor exposure.
                        Appropriate cleaning helps address buildup without
                        relying on excessive pressure.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>03</span>
                    <h3>Composite Decking</h3>
                    <p>
                        Composite decking can collect dirt, pollen, and organic
                        buildup. Cleaning methods should account for the
                        product's surface and manufacturer recommendations.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>04</span>
                    <h3>PVC & Manufactured Decking</h3>
                    <p>
                        PVC and other manufactured decking products may have
                        specific cleaning requirements. Surface finishes and
                        product guidance should be considered before treatment.
                    </p>
                </div>
            </div>
        </section>

        <!-- ============================================
         INFO
        ============================================= -->

        <section class="service-info-section service-info-split">
            <div>
                <p class="section-eyebrow">Common Deck Concerns</p>
                <h2>What's Building Up on Your Deck?</h2>
            </div>

            <div class="service-info-copy">
                <p>
                    Decks experience a combination of foot traffic, changing
                    weather, moisture, and environmental exposure. These
                    conditions can contribute to visible buildup and changes in
                    appearance.
                </p>

                <ul class="service-check-list">
                    <li>Dirt and environmental grime</li>
                    <li>Green algae and organic buildup</li>
                    <li>Dark discoloration in shaded areas</li>
                    <li>Mildew-related staining</li>
                    <li>Pollen and seasonal debris</li>
                    <li>Food and beverage staining</li>
                    <li>Weather-related discoloration</li>
                </ul>

                <p>
                    Some discoloration may be associated with aging, UV
                    exposure, deteriorated finishes, or changes within the
                    decking material. Cleaning may improve appearance without
                    reversing those conditions.
                </p>
            </div>
        </section>

        <!-- ============================================
         CLEANING APPROACH
        ============================================= --> 

        <section class="service-info-section service-method-section">
            <div class="service-info-heading">
                <p class="section-eyebrow">The Cleaning Approach</p>
                <h2>Care Matters When Cleaning Decks</h2>
            </div>

            <div class="service-method-content">
                <p>
                    Deck cleaning is not simply a matter of applying the highest
                    possible water pressure. Different materials respond
                    differently to cleaning equipment and products.
                </p>

                <p>
                    Wood decking can be damaged by excessive pressure, which may
                    raise the grain or cause splintering. Composite and
                    manufactured decking products may have specific requirements
                    involving cleaning solutions, pressure, and surface
                    finishes.
                </p>

                <p>
                    The appropriate method should account for the decking
                    material, existing condition, manufacturer guidance, and the
                    type of buildup being addressed.
                </p>
            </div>
        </section>

        <!-- ============================================
         DECK FEATURES
        ============================================= -->

        <section class="service-info-section">
            <div class="service-info-heading">
                <p class="section-eyebrow">Beyond the Deck Boards</p>
                <h2>Details That Complete Your Outdoor Space</h2>
                <p>
                    A deck includes more than its main walking surface.
                    Additional features can collect buildup and may benefit from
                    cleaning.
                </p>
            </div>

            <div class="service-info-grid">
                <div class="service-info-card">
                    <span>01</span>
                    <h3>Deck Boards</h3>
                    <p>
                        Addressing dirt and suitable organic buildup across the
                        main decking surface.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>02</span>
                    <h3>Railings & Balusters</h3>
                    <p>
                        Cleaning compatible railing materials affected by
                        outdoor grime and environmental exposure.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>03</span>
                    <h3>Stairs & Landings</h3>
                    <p>
                        Refreshing steps and landing areas that experience
                        regular foot traffic and outdoor buildup.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>04</span>
                    <h3>Posts & Exterior Details</h3>
                    <p>
                        Addressing applicable buildup on compatible posts, trim,
                        and other deck features.
                    </p>
                </div>
            </div>
        </section>

        <!-- ============================================
         BENEFITS
        ============================================= --> 

        <section class="service-info-section service-info-split">
            <div>
                <p class="section-eyebrow">Outdoor Appearance</p>
                <h2>Make the Most of Your Outdoor Space</h2>
            </div>

            <div class="service-info-copy">
                <p>
                    Your deck is a place for everyday relaxation, family
                    gatherings, and enjoying the outdoors. Removing accumulated
                    buildup can help create a cleaner, more inviting space.
                </p>

                <ul class="service-check-list">
                    <li>Refreshes the appearance of decking surfaces</li>
                    <li>Addresses suitable dirt and organic buildup</li>
                    <li>Complements fence and exterior house cleaning</li>
                    <li>
                        Helps prepare certain surfaces for separate finishing
                        work
                    </li>
                    <li>
                        Provides an opportunity to identify visible surface
                        concerns
                    </li>
                </ul>

                <p>
                    Deck cleaning does not replace structural repairs, sanding,
                    staining, sealing, or replacement of damaged boards.
                </p>
            </div>
        </section>

        <!-- ============================================
         PROCESS
        ============================================= -->

        <section class="service-info-section">
            <div class="service-info-heading">
                <p class="section-eyebrow">What to Expect</p>
                <h2>Our Deck Cleaning Process</h2>
                <p>
                    Every deck is different. The material, condition, existing
                    finish, and type of buildup help determine the appropriate
                    cleaning plan.
                </p>
            </div>

            <div class="service-process-grid">
                <div class="service-process-step">
                    <span>01</span>
                    <h3>Discuss Your Deck</h3>
                    <p>
                        Tell us about the decking material, approximate size,
                        visible buildup, and any specific concerns.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>02</span>
                    <h3>Evaluate the Surface</h3>
                    <p>
                        Consider the material, existing finish, condition, and
                        accessibility before selecting a cleaning method.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>03</span>
                    <h3>Perform the Cleaning</h3>
                    <p>
                        Address the agreed-upon areas using methods appropriate
                        for the decking material and its condition.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>04</span>
                    <h3>Review the Results</h3>
                    <p>
                        Review the cleaned deck and discuss any remaining
                        staining, weathering, or surface concerns.
                    </p>
                </div>
            </div>
        </section>

        <!-- ============================================
         FAQ
        ============================================= -->
        <ServiceFAQ faqs={faqs} />
    </div>
</ServiceLayout>
