---
import ServiceLayout from "../../layouts/ServiceLayout.astro";
import ServiceFAQ from "../../components/ServiceFAQ.astro";

const faqs = [
    {
        question: "What types of fences can be cleaned?",
        answer: "Common fence materials include wood, vinyl, composite, and metal. Each material has different cleaning requirements, so the appropriate method depends on the surface, finish, condition, and type of buildup.",
    },
    {
        question: "Can fence cleaning remove green algae?",
        answer: "Exterior cleaning can address many types of algae-related discoloration and organic buildup. Results depend on the fence material, its condition, and how deeply the staining has developed.",
    },
    {
        question: "Is pressure washing safe for wooden fences?",
        answer: "Wood requires particular care because excessive pressure can damage the surface, raise the grain, or cause splintering. Cleaning methods should be selected according to the wood's condition and finish.",
    },
    {
        question: "Can cleaning restore weathered wood to its original color?",
        answer: "Cleaning can remove applicable surface buildup and improve the appearance of wood, but natural weathering, UV exposure, and permanent discoloration may remain. Cleaning is not the same as sanding, staining, or refinishing.",
    },
    {
        question: "Can you clean painted or stained fences?",
        answer: "Painted and stained surfaces require consideration of the existing finish. Loose paint, deteriorated coatings, and certain stains may be affected by cleaning, so the condition of the finish should be evaluated beforehand.",
    },
    {
        question: "Can you remove rust from metal fencing?",
        answer: "Some rust staining may require specialized treatment. Cleaning does not repair corrosion, damaged coatings, or deteriorated metal. Rust removal and surface restoration should be discussed separately.",
    },
    {
        question: "How often should a fence be cleaned?",
        answer: "Cleaning frequency depends on the material, surrounding vegetation, shade, moisture, and environmental exposure. Fences near trees or damp areas may develop visible buildup more quickly.",
    },
    {
        question: "Do I need to move anything before fence cleaning?",
        answer: "It is helpful to discuss furniture, decorations, planters, nearby vegetation, and access to both sides of the fence before the appointment. Preparation requirements depend on the property and scope of work.",
    },
    {
        question: "How do I request a fence cleaning quote?",
        answer: "Contact South Hills Soft Wash with your fence material, approximate length, and any areas of concern. Photos can help communicate the condition of the fence and the type of cleaning needed.",
    },
];
---

<ServiceLayout
    title="Fence Cleaning"
    seoTitle="Fence Cleaning"
    description="Refresh your property's fencing by addressing dirt, organic buildup, and exterior discoloration with methods suited to the material."
    image="/images/residential/fence_cleaning.jpg"
    seoDescription="Professional fence cleaning from South Hills Soft Wash for homes throughout the South Hills and surrounding Pittsburgh communities."
>
    <p class="section-eyebrow">Fences & Outdoor Spaces</p>

    <h2>Give Your Fence a Fresh Look</h2>

    <p>
        Fences provide privacy, define outdoor spaces, and contribute to your
        property's overall appearance. Because they're exposed to the elements
        year-round, they can accumulate dirt, algae, and environmental staining
        over time.
    </p>

    <p>
        Professional fence cleaning helps address that buildup while considering
        the material and condition of the surface. Wood, vinyl, composite, and
        metal fencing each require an appropriate cleaning approach.
    </p>

    <div slot="extra">
        <!-- ============================================
         FENCE MATERIALS
        ============================================= -->

        <section class="service-info-section">
            <div class="service-info-heading">
                <p class="section-eyebrow">Fence Materials</p>
                <h2>Cleaning for Different Fence Types</h2>
                <p>
                    Each fencing material responds differently to moisture,
                    outdoor exposure, and cleaning. The appropriate method
                    starts with identifying the surface and its condition.
                </p>
            </div>

            <div class="service-info-grid">
                <div class="service-info-card">
                    <span>01</span>
                    <h3>Wood Fencing</h3>
                    <p>
                        Wood fences can develop organic buildup, environmental
                        staining, and weathered discoloration. Cleaning should
                        account for the wood's age, condition, and finish.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>02</span>
                    <h3>Vinyl Fencing</h3>
                    <p>
                        Vinyl fencing can collect dirt, algae, and other surface
                        buildup, particularly in shaded or damp areas.
                        Appropriate cleaning can refresh its appearance.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>03</span>
                    <h3>Composite Fencing</h3>
                    <p>
                        Composite materials may require specific cleaning
                        products and procedures. Manufacturer recommendations
                        and the condition of the finish should be considered.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>04</span>
                    <h3>Metal Fencing</h3>
                    <p>
                        Aluminum, steel, and other metal fences can accumulate
                        grime and discoloration. Cleaning methods should account
                        for protective coatings and any existing corrosion.
                    </p>
                </div>
            </div>
        </section>

        <!-- ============================================
         COMMON BUILDUP
        ============================================= -->

        <section class="service-info-section service-info-split">
            <div>
                <p class="section-eyebrow">Common Fence Concerns</p>
                <h2>What's Affecting Your Fence?</h2>
            </div>

            <div class="service-info-copy">
                <p>
                    Fences are exposed to rain, sunlight, soil, vegetation, and
                    changing weather conditions. These factors can contribute to
                    visible buildup and changes in appearance.
                </p>

                <ul class="service-check-list">
                    <li>Dirt and environmental grime</li>
                    <li>Green algae and organic buildup</li>
                    <li>Dark discoloration in shaded areas</li>
                    <li>Mildew-related staining</li>
                    <li>Pollen and seasonal debris</li>
                    <li>Soil splatter near the base of the fence</li>
                    <li>Weather-related discoloration</li>
                </ul>

                <p>
                    Some discoloration is caused by aging, UV exposure,
                    deteriorated coatings, or changes within the material
                    itself. Cleaning may improve appearance without reversing
                    those conditions.
                </p>
            </div>
        </section>

        <!-- ============================================
         CLEANING APPROACH
        ============================================= -->

        <section class="service-info-section service-method-section">
            <div class="service-info-heading">
                <p class="section-eyebrow">The Cleaning Approach</p>
                <h2>The Right Method for the Material</h2>
            </div>

            <div class="service-method-content">
                <p>
                    A wooden privacy fence and a vinyl fence may experience
                    similar outdoor buildup, but that doesn't mean they should
                    be cleaned using identical methods.
                </p>

                <p>
                    Wood can be affected by excessive pressure, particularly
                    when it is weathered or deteriorated. Vinyl, composite, and
                    metal surfaces have their own considerations involving
                    finishes, coatings, and manufacturer recommendations.
                </p>

                <p>
                    The cleaning approach should be selected according to the
                    material, its condition, and the type of buildup present
                    rather than relying on one method for every fence.
                </p>
            </div>
        </section>

        <!-- ============================================
         BENEFITS
        ============================================= -->

        <section class="service-info-section service-info-split">
            <div>
                <p class="section-eyebrow">Outdoor Appearance</p>
                <h2>Refresh Your Outdoor Space</h2>
            </div>

            <div class="service-info-copy">
                <p>
                    Your fence frames your yard and contributes to the
                    appearance of your outdoor living space. Removing
                    accumulated buildup can help it look cleaner and better
                    maintained.
                </p>

                <ul class="service-check-list">
                    <li>Refreshes the appearance of fence panels and posts</li>
                    <li>Addresses suitable dirt and organic buildup</li>
                    <li>Complements deck and patio cleaning</li>
                    <li>
                        Helps prepare certain surfaces for separate finishing
                        work
                    </li>
                    <li>
                        Provides an opportunity to identify visible surface
                        concerns
                    </li>
                </ul>

                <p>
                    Fence cleaning does not replace repairs, painting, staining,
                    sealing, or replacement of damaged materials.
                </p>
            </div>
        </section>

        <!-- ============================================
         PROCESS
        ============================================= -->

        <section class="service-info-section">
            <div class="service-info-heading">
                <p class="section-eyebrow">What to Expect</p>
                <h2>Our Fence Cleaning Process</h2>
                <p>
                    Every fence is different. The material, condition,
                    accessibility, and type of buildup help determine the
                    cleaning plan.
                </p>
            </div>

            <div class="service-process-grid">
                <div class="service-process-step">
                    <span>01</span>
                    <h3>Discuss Your Fence</h3>
                    <p>
                        Tell us about the fence material, approximate size,
                        visible buildup, and any areas of concern.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>02</span>
                    <h3>Evaluate the Surface</h3>
                    <p>
                        Consider the material, existing finish, condition, and
                        access before selecting a cleaning approach.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>03</span>
                    <h3>Perform the Cleaning</h3>
                    <p>
                        Address the agreed-upon areas using methods appropriate
                        for the fencing material.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>04</span>
                    <h3>Review the Results</h3>
                    <p>
                        Review the cleaned fence and discuss any remaining
                        staining, weathering, or surface concerns.
                    </p>
                </div>
            </div>
        </section>

        <!-- ============================================
         FAQ
        ============================================= -->

        <ServiceFAQ faqs={faqs} />
    </div>
</ServiceLayout>
