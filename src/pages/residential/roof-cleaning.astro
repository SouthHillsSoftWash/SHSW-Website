---
import ServiceLayout from "../../layouts/ServiceLayout.astro";
import ServiceFAQ from "../../components/ServiceFAQ.astro";

const faqs = [
    {
        question: "What causes black streaks on a roof?",
        answer: "Black roof streaks are commonly associated with an algae called Gloeocapsa magma. Moisture and environmental conditions can contribute to its growth, particularly on asphalt shingles.",
    },
    {
        question: "Can roof cleaning remove algae and moss?",
        answer: "Roof cleaning can address algae and certain organic growth, including moss and lichen. The appropriate treatment and expected results depend on the roofing material, its condition, and the extent of the growth. Some growth may release gradually rather than disappearing immediately.",
    },
    {
        question: "Is soft washing different from pressure washing a roof?",
        answer: "Yes. Soft washing relies on low-pressure application and suitable cleaning solutions rather than high-pressure water. Excessive pressure can damage roofing materials, particularly asphalt shingles.",
    },
    {
        question: "What types of roofs can be cleaned?",
        answer: "Cleaning methods vary for asphalt shingles, metal roofing, tile, and other materials. Roof condition, manufacturer guidance, and the type of buildup should be considered before selecting a treatment.",
    },
    {
        question: "How often should a roof be cleaned?",
        answer: "Cleaning frequency depends on factors such as shade, surrounding trees, moisture, roof material, and visible organic growth. There is no single schedule that applies to every property.",
    },
    {
        question: "Will roof cleaning fix leaks or damaged shingles?",
        answer: "No. Roof cleaning addresses exterior buildup and staining; it is not a substitute for roof repairs. Loose, damaged, or deteriorated roofing materials should be evaluated by a qualified roofing professional.",
    },
    {
        question: "Will all stains disappear immediately?",
        answer: "Results depend on the material and type of staining. Some organic buildup may require time to release after treatment, while permanent discoloration or material deterioration may not be reversible through cleaning.",
    },
    {
        question: "How do I request a roof cleaning quote?",
        answer: "Contact South Hills Soft Wash with information about your property, roofing material, and areas of concern. Photos can also help communicate what you would like addressed.",
    },
];
---

<ServiceLayout
    title="Roof Cleaning"
    seoTitle="Roof Cleaning in South Hills, PA"
    description="Refresh your roof's appearance by addressing algae, staining, and exterior buildup with a cleaning approach suited to the roofing material."
    image="/images/residential/roof_cleaning.jpg"
    seoDescription="Professional roof cleaning and soft washing from South Hills Soft Wash for homes throughout the South Hills and surrounding Pittsburgh communities."
>
    <p class="section-eyebrow">Exterior Roof Care</p>

    <h2>A Cleaner Look, From the Top Down</h2>

    <p>
        Your roof is one of the most visible parts of your home's exterior. Over
        time, moisture, shade, and environmental exposure can contribute to dark
        streaks, discoloration, and organic growth.
    </p>

    <p>
        Professional roof cleaning focuses on addressing that buildup while
        considering the roofing material and its condition. Different roof types
        require different cleaning methods, so the approach should be selected
        for the surface being treated.
    </p>

    <div slot="extra">
        <!-- ============================================
         ROOF MATERIALS
    ============================================= -->

        <section class="service-info-section">
            <div class="service-info-heading">
                <p class="section-eyebrow">Roofing Materials</p>
                <h2>Different Roofs, Different Needs</h2>
                <p>
                    Roof cleaning is not a one-size-fits-all service. The
                    material, age, condition, and type of buildup all influence
                    the appropriate approach.
                </p>
            </div>

            <div class="service-info-grid">
                <div class="service-info-card">
                    <span>01</span>
                    <h3>Asphalt Shingles</h3>
                    <p>
                        Commonly affected by dark algae streaks and organic
                        buildup. Cleaning methods should account for the
                        protective granules and condition of the shingles.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>02</span>
                    <h3>Metal Roofing</h3>
                    <p>
                        Metal roofs can develop environmental grime, organic
                        buildup, and surface discoloration. Coatings, finishes,
                        and manufacturer guidance should be considered before
                        cleaning.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>03</span>
                    <h3>Tile Roofing</h3>
                    <p>
                        Clay and concrete tiles require cleaning methods
                        appropriate for their material and condition,
                        particularly where tiles are weathered or fragile.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>04</span>
                    <h3>Other Roof Surfaces</h3>
                    <p>
                        Specialty roofing materials may require different
                        products, equipment, or cleaning procedures. The surface
                        should be evaluated before treatment.
                    </p>
                </div>
            </div>
        </section>

        <!-- ============================================
         COMMON ROOF BUILDUP
    ============================================= -->

        <section class="service-info-section service-info-split">
            <div>
                <p class="section-eyebrow">Common Roof Concerns</p>
                <h2>What's Growing on Your Roof?</h2>
            </div>

            <div class="service-info-copy">
                <p>
                    Roof discoloration can have several causes. Identifying the
                    type of buildup helps determine which cleaning method may be
                    appropriate.
                </p>

                <ul class="service-check-list">
                    <li>Black streaks commonly associated with roof algae</li>
                    <li>Green algae and other organic growth</li>
                    <li>Moss in damp or shaded areas</li>
                    <li>Lichen attached to roofing surfaces</li>
                    <li>Dirt, pollen, and environmental debris</li>
                    <li>Discoloration caused by prolonged outdoor exposure</li>
                </ul>

                <p>
                    Some discoloration may be permanent or related to the
                    roofing material itself. Cleaning results depend on the
                    condition of the surface and the cause of the staining.
                </p>
            </div>
        </section>

        <!-- ============================================
         SOFT WASHING
    ============================================= -->

        <section class="service-info-section service-method-section">
            <div class="service-info-heading">
                <p class="section-eyebrow">The Cleaning Approach</p>
                <h2>Why Roof Cleaning Requires Care</h2>
            </div>

            <div class="service-method-content">
                <p>
                    Roofing materials are designed to protect your home from the
                    elements, but that does not mean they should be subjected to
                    excessive cleaning pressure.
                </p>

                <p>
                    Soft washing uses low-pressure application and cleaning
                    solutions to address organic buildup. For suitable roofing
                    materials, this approach avoids relying on high-pressure
                    water to remove staining.
                </p>

                <p>
                    The roof's material, condition, manufacturer
                    recommendations, and surrounding property should all be
                    considered when planning a cleaning service.
                </p>
            </div>
        </section>

        <!-- ============================================
         PROCESS
    ============================================= -->

        <section class="service-info-section">
            <div class="service-info-heading">
                <p class="section-eyebrow">What to Expect</p>
                <h2>Our Roof Cleaning Process</h2>
                <p>
                    Each roof has different cleaning needs. Here's a general
                    overview of how a roof cleaning service is approached.
                </p>
            </div>

            <div class="service-process-grid">
                <div class="service-process-step">
                    <span>01</span>
                    <h3>Discuss Your Roof</h3>
                    <p>
                        Tell us about the roofing material, visible staining,
                        and any specific concerns you have.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>02</span>
                    <h3>Evaluate Conditions</h3>
                    <p>
                        Consider the roof's material, condition, accessibility,
                        and type of buildup before selecting a cleaning
                        approach.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>03</span>
                    <h3>Roof Cleaning</h3>
                    <p>
                        Apply the appropriate treatment to the agreed-upon areas
                        using methods suited to the roofing surface.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>04</span>
                    <h3>Review the Results</h3>
                    <p>
                        Review the completed service and discuss any areas where
                        remaining organic buildup may require additional time to
                        release.
                    </p>
                </div>
            </div>
        </section>

        <!-- ============================================
         FAQ
    ============================================= -->
        <ServiceFAQ faqs={faqs} />
    </div>
</ServiceLayout>
