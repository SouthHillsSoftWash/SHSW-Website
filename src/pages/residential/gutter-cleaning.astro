
---
import ServiceLayout from "../../layouts/ServiceLayout.astro";
import ServiceFAQ from "../../components/ServiceFAQ.astro";

const faqs = [
    {
        question: "What is the difference between gutter cleaning and gutter brightening?",
        answer: "Gutter cleaning generally refers to removing leaves, twigs, and other debris from inside the gutter system. Gutter brightening focuses on cleaning the visible exterior surfaces, including certain streaks and discoloration. These are separate cleaning needs and should be discussed when requesting a quote."
    },
    {
        question: "What causes dark streaks on the outside of gutters?",
        answer: "Dark vertical streaks are often associated with environmental buildup and staining on the gutter finish. These marks are sometimes called tiger stripes. Their removability depends on the type of staining and the condition of the gutter's coating."
    },
    {
        question: "How often should gutters be cleaned?",
        answer: "Cleaning frequency depends on surrounding trees, seasonal leaf fall, weather, and how quickly debris accumulates. Homes surrounded by trees may need more frequent attention than properties with little nearby vegetation."
    },
    {
        question: "Can clogged gutters cause problems?",
        answer: "Debris can restrict water flow and contribute to overflowing gutters. Persistent drainage problems may expose fascia, siding, foundations, and surrounding landscaping to unwanted water. Cleaning can address debris-related restrictions, but damaged or improperly installed systems may require repairs."
    },
    {
        question: "Do downspouts need cleaning too?",
        answer: "Downspouts are part of the gutter drainage system and can develop blockages. If you suspect a downspout is clogged, mention it when requesting your quote so the appropriate scope of work can be discussed."
    },
    {
        question: "Can you clean gutters that have gutter guards?",
        answer: "Gutter guards vary in design and may still collect debris on or beneath them. Access and cleaning requirements depend on the guard system, its condition, and whether removal is necessary or appropriate."
    },
    {
        question: "Will cleaning fix leaking or sagging gutters?",
        answer: "Cleaning removes applicable debris and buildup, but it does not repair damaged seams, loose fasteners, incorrect pitch, or deteriorated sections. Those issues may require a gutter repair or installation professional."
    },
    {
        question: "How can I request a gutter cleaning quote?",
        answer: "Contact South Hills Soft Wash with your property's details and let us know whether you need interior debris removal, exterior gutter cleaning, downspout attention, or a combination of services."
    }
];
---


<ServiceLayout
    title="Gutter Cleaning"
    seoTitle="Gutter Cleaning"
    description="Keep your gutters looking cleaner and address debris that can interfere with proper water flow."
    image="/images/residential/gutter_cleaning.jpg"
    seoDescription="Professional gutter cleaning from South Hills Soft Wash for homeowners throughout the South Hills and surrounding Pittsburgh communities."
>

    <p class="section-eyebrow">Exterior Gutter Care</p>

    <h2>Clean Gutters, From the Inside Out</h2>

    <p>
        Gutters collect rainwater and direct it away from your
        home's exterior. Over time, leaves, twigs, dirt, and
        other debris can accumulate inside the system and
        interfere with drainage.
    </p>

    <p>
        The visible exterior can also develop dark streaks,
        environmental grime, and discoloration. Interior
        gutter cleaning and exterior gutter brightening
        address different concerns, making it important
        to identify which services your property needs.
    </p>

    
    <div slot="extra">

        <!-- GUTTER SERVICES -->

        <section class="service-info-section">
            <div class="service-info-heading">
                <p class="section-eyebrow">Gutter Care</p>
                <h2>What Does Gutter Cleaning Include?</h2>
                <p>
                    Different gutter problems require different
                    solutions. Explore the areas that may need
                    attention around your home.
                </p>
            </div>

            <div class="service-info-grid">

                <div class="service-info-card">
                    <span>01</span>
                    <h3>Interior Debris Removal</h3>
                    <p>
                        Removing accumulated leaves, twigs, and
                        other debris that can restrict the flow
                        of water through gutter channels.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>02</span>
                    <h3>Exterior Gutter Cleaning</h3>
                    <p>
                        Addressing dirt, grime, and applicable
                        staining on the visible exterior
                        surfaces of the gutter system.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>03</span>
                    <h3>Downspout Attention</h3>
                    <p>
                        Identifying potential debris-related
                        restrictions in the downspouts that
                        carry water away from the gutters.
                    </p>
                </div>

                <div class="service-info-card">
                    <span>04</span>
                    <h3>Gutter Brightening</h3>
                    <p>
                        Targeted exterior cleaning for certain
                        streaks and discoloration, using an
                        approach appropriate for the gutter finish.
                    </p>
                </div>

            </div>
        </section>


        <!-- COMMON GUTTER PROBLEMS -->

        <section class="service-info-section service-info-split">

            <div>
                <p class="section-eyebrow">Signs to Watch For</p>
                <h2>When Your Gutters Need Attention</h2>
            </div>

            <div class="service-info-copy">
                <p>
                    Gutter buildup is not always visible from
                    the ground. However, certain signs can
                    indicate that cleaning or further inspection
                    may be needed.
                </p>

                <ul class="service-check-list">
                    <li>Leaves and debris visible in gutter channels</li>
                    <li>Water overflowing during rainfall</li>
                    <li>Water draining slowly or pooling in sections</li>
                    <li>Plants or vegetation growing in accumulated debris</li>
                    <li>Dark streaks on exterior gutter surfaces</li>
                    <li>Visible dirt and discoloration</li>
                    <li>Water spilling near the home's foundation</li>
                </ul>

                <p>
                    Overflowing gutters can also result from
                    damaged sections, improper slope, or other
                    drainage problems. Cleaning alone may not
                    resolve every issue.
                </p>
            </div>

        </section>


        <!-- GUTTER BRIGHTENING -->

        <section class="service-info-section service-method-section">

            <div class="service-info-heading">
                <p class="section-eyebrow">Exterior Appearance</p>
                <h2>What Is Gutter Brightening?</h2>
            </div>

            <div class="service-method-content">
                <p>
                    Have you noticed dark vertical streaks
                    running down otherwise light-colored
                    gutters? These marks are commonly
                    referred to as gutter tiger stripes.
                </p>

                <p>
                    Routine exterior washing may not remove
                    every type of staining. Gutter brightening
                    uses a more targeted cleaning approach
                    to address suitable exterior discoloration.
                </p>

                <p>
                    The gutter's finish and condition matter.
                    Oxidation, damaged coatings, and permanent
                    discoloration may not be reversible through
                    cleaning, and some surfaces require
                    additional care.
                </p>
            </div>

        </section>


        <!-- WHY GUTTER MAINTENANCE MATTERS -->

        <section class="service-info-section service-info-split">

            <div>
                <p class="section-eyebrow">Beyond Appearance</p>
                <h2>Why Gutter Maintenance Matters</h2>
            </div>

            <div class="service-info-copy">
                <p>
                    A gutter system is designed to collect
                    rainwater from the roof and direct it
                    through downspouts to an appropriate
                    drainage location.
                </p>

                <p>
                    When debris obstructs that path, water
                    may overflow or collect where it
                    shouldn't. Keeping the system clear
                    helps support its intended drainage
                    function.
                </p>

                <ul class="service-check-list">
                    <li>Supports unobstructed rainwater flow</li>
                    <li>Reduces debris-related overflow</li>
                    <li>Helps limit unwanted water exposure around exterior surfaces</li>
                    <li>Allows visible drainage concerns to be identified</li>
                    <li>Improves the appearance of the gutter system</li>
                </ul>

                <p>
                    Regular cleaning is one part of gutter
                    maintenance. Repairs, drainage adjustments,
                    and replacement of damaged components
                    are separate considerations.
                </p>
            </div>

        </section>


        <!-- PROCESS -->

        <section class="service-info-section">

            <div class="service-info-heading">
                <p class="section-eyebrow">What to Expect</p>
                <h2>Our Gutter Cleaning Process</h2>
                <p>
                    The scope of work depends on your gutter
                    system and the type of cleaning requested.
                </p>
            </div>

            <div class="service-process-grid">

                <div class="service-process-step">
                    <span>01</span>
                    <h3>Discuss Your Needs</h3>
                    <p>
                        Tell us about your gutters, visible
                        buildup, drainage concerns, and whether
                        you're interested in exterior brightening.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>02</span>
                    <h3>Evaluate the System</h3>
                    <p>
                        Consider accessibility, gutter
                        condition, accumulated debris,
                        and the areas requiring attention.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>03</span>
                    <h3>Perform the Cleaning</h3>
                    <p>
                        Address the agreed-upon interior
                        and exterior cleaning needs using
                        methods suited to the gutter system.
                    </p>
                </div>

                <div class="service-process-step">
                    <span>04</span>
                    <h3>Review the Work</h3>
                    <p>
                        Review the completed cleaning and
                        discuss any visible concerns that
                        may require separate maintenance
                        or repairs.
                    </p>
                </div>

            </div>

        </section>
        <!-- FAQ -->
        <ServiceFAQ faqs={faqs} />

    </div>


</ServiceLayout>

