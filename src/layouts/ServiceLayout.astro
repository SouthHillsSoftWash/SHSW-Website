---
import BaseLayout from "./BaseLayout.astro";

interface Props {
    title: string;
    description: string;
    image: string;
    category?: "Residential" | "Commercial";
}

const {
    title,
    description,
    image,
    category = "Residential"
} = Astro.props;

const categoryLink =
    category === "Commercial"
        ? "/commercial/"
        : "/residential/";
---

<BaseLayout title={`${title} | South Hills Soft Wash`}>

    <section class="service-detail-hero">
        <div class="service-detail-container">

            <a href={categoryLink} class="service-back-link">
                <span aria-hidden="true">←</span>
                All {category} Services
            </a>

            <p class="section-eyebrow">{category} Services</p>
            <h1>{title}</h1>
            <p>{description}</p>
            
        </div>

            <svg
                class="service-detail-wave"
                viewBox="0 0 1440 100"
                preserveAspectRatio="none"
                aria-hidden="true"
            >
                <path
                    d="M0,35 C240,90 480,0 720,42 S1200,90 1440,30 L1440,100 L0,100 Z"
                />
            </svg>
    </section>

    <section class="service-detail-main">
        <div class="service-detail-container">

            <div class="service-detail-grid">

                <div class="service-detail-image">
                    <img
                        src={image}
                        alt={`${title} by South Hills Soft Wash`}
                    />
                </div>

                <div class="service-detail-content">
                    <slot />
                </div>

            </div>

            <div class="service-detail-extra">
                <slot name="extra" />
            </div>

        </div>
    </section>

    <section class="service-detail-cta">

        <svg
            class="service-detail-cta-wave"
            viewBox="0 0 1440 100"
            preserveAspectRatio="none"
            aria-hidden="true"
        >
            <defs>
                <linearGradient id="service-cta-gradient" x1="0%" y1="0%" x2="100%" y2="0%">
                    <stop offset="0%" stop-color="#429D8E" />
                    <stop offset="100%" stop-color="#73BF68" />
                </linearGradient>
            </defs>

            <path
                d="M0,35 C240,90 480,0 720,42 S1200,90 1440,30 L1440,100 L0,100 Z"
                fill="url(#service-cta-gradient)"
            />
        </svg>

        <div class="service-detail-container">
            <h2>Ready to Refresh Your Property?</h2>
            <p>Get in touch with South Hills Soft Wash to request a free quote.</p>

            <a href="/contact/" class="service-detail-cta-button">
                Request a Free Quote
                <span aria-hidden="true">→</span>
            </a>
        </div>

    </section>

</BaseLayout>