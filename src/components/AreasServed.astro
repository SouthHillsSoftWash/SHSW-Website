---
import "leaflet/dist/leaflet.css";
---

<section class="areas-served">
    <div class="areas-container">

        <div class="areas-content">
            <p class="section-eyebrow">Areas Served</p>

            <h2>Local Care. Beautiful Results.</h2>

            <p class="areas-description">
                South Hills Soft Wash proudly serves homeowners and
                businesses throughout the South Hills of Pittsburgh
                and surrounding communities.
            </p>

            <p class="areas-description">
                Located outside the South Hills? Reach out to see
                if your property falls within our service area.
            </p>

            <a href="/areas-served/" class="areas-link">
                Explore Our Service Area
                <span aria-hidden="true">→</span>
            </a>
        </div>

        <div class="areas-visual">
            <div
                id="service-map"
                aria-label="Map of communities surrounding Monongahela, Pennsylvania"
            ></div>
        </div>

    </div>
</section>

<script>
    import L from "leaflet";

    const mapElement = document.getElementById("service-map");
    const locations = [
        { name: "Monongahela", coords: [40.2031, -79.9262] },
        { name: "Bethel Park", coords: [40.3276, -80.0395] },
        { name: "Peters Township", coords: [40.2659, -80.0823] },
        { name: "Canonsburg", coords: [40.2626, -80.1873] },
        { name: "Washington", coords: [40.1739, -80.2462] },
        { name: "Belle Vernon", coords: [40.1251, -79.8664] },
        { name: "Irwin", coords: [40.3245, -79.7081] },
        { name: "Mt. Lebanon", coords: [40.3553, -80.0495] },
        { name: "West Mifflin", coords: [40.3634, -79.8664] },
    ];

    if (mapElement) {
        const map = L.map(mapElement, {
            scrollWheelZoom: false,
        }).setView([40.20, -79.93], 10);

        L.tileLayer(
            "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
            {
                attribution:
                    '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
                maxZoom: 19,
            }
        ).addTo(map);

        const serviceIcon = L.divIcon({
            className: "service-map-marker",
            html: '<span class="service-map-dot"></span>',
            iconSize: [24, 24],
            iconAnchor: [12, 12],
        });

        locations.forEach((location) => {
            L.marker(location.coords as [number, number], {
                icon: serviceIcon,
            })
                .addTo(map)
                .bindPopup(`<strong>${location.name}</strong>`);
        });

        const bounds = L.latLngBounds(
            locations.map((location) => location.coords as [number, number])
        );

        map.fitBounds(bounds, {
            padding: [35, 35],
            maxZoom: 10,
        });
    }
</script>