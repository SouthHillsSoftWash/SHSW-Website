---
interface Props {
    title: string;
    description: string;
    href: string;
    category: string;
}

const {
    title,
    description,
    href,
    category
} = Astro.props;
---

<article class="service-card">
    <div class="service-card-content">
        <p class="service-card-category">{category}</p>
        <h3>{title}</h3>
        <p class="service-card-description">
            {description}</p>
        <a href={href} class="service-card-link">
            Learn More →</a>
    </div>
</article>